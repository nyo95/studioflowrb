# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"

# =============================================================================
# PRODUCTION (Vercel + Supabase)
# =============================================================================
#
# Supabase memberi dua URL berbeda:
#
# 1. DIRECT_URL — koneksi langsung ke PostgreSQL (port 5432)
#    Dipakai HANYA oleh Prisma CLI untuk migration. Tidak pernah dipakai app.
#    Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# 2. DATABASE_URL — Supabase Transaction Pooler via PgBouncer (port 6543)
#    Dipakai app di runtime (Vercel functions). Menangani max-connection problem.
#    Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#    Catatan: username-nya "postgres.PROJECT_REF" (bukan "postgres")
#
# Keduanya bisa disalin dari: Supabase Dashboard → Settings → Database → Connection string

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"

# =============================================================================
# DB POOL — Vercel serverless: kecilkan pool, PgBouncer yang handle multiplexing
# =============================================================================
# Vercel: DB_POOL_MAX=2, DB_POOL_IDLE_TIMEOUT_MS=0
# Lokal:  DB_POOL_MAX=10, DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_CONNECTION_TIMEOUT_MS="5000"

# =============================================================================
# AUTH
# =============================================================================
# Set "true" di Vercel (Vercel meneruskan x-forwarded-for secara aman).
# Set "false" di lokal.
AUTH_TRUST_PROXY_CLIENT_IP="false"

# Server-only Supabase Storage credentials. Never prefix these with NEXT_PUBLIC.
# The private platform-assets bucket is provisioned outside application runtime.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# TEST (tidak perlu di Vercel)
# =============================================================================
PLATFORM_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild_test"
