DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"

# Core DB pool tuning — optional, non-secret operational settings only.
# Omitted or empty values fall back to the conservative defaults:
#   max=10, idleTimeoutMillis=30000, connectionTimeoutMillis=5000
DB_POOL_MAX="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_CONNECTION_TIMEOUT_MS="5000"

# Login rate limiting (Foundation F0). Forwarded client-IP headers
# (x-forwarded-for) are trusted ONLY when this is explicitly "true". When
# disabled, all requests share ONE non-spoofable deployment-local fallback
# bucket for the network limit (25 attempts / 15 min, 30-min block) — a known
# limitation for deployments where a trusted proxy is not configured. Per-email
# limits are unaffected (5 attempts / 15 min per normalized email, hashed key).
AUTH_TRUST_PROXY_CLIENT_IP="false"

# Integration/DB contract tests additionally require MASTERDATA_TEST_DATABASE_URL
# to point at the SAME disposable PostgreSQL database as DATABASE_URL. They are
# not needed for ordinary development or production runs.
