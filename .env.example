DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"

# Core DB pool tuning — optional, non-secret operational settings only.
# Omitted or empty values fall back to the conservative defaults:
#   max=10, idleTimeoutMillis=30000, connectionTimeoutMillis=5000
DB_POOL_MAX="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_CONNECTION_TIMEOUT_MS="5000"
