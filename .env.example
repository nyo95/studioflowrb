# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"

# =============================================================================
# SELF-HOSTED / LOCAL DEPLOYMENT
# =============================================================================
# DATABASE_URL dan DIRECT_URL menunjuk ke database lokal/self-hosted yang
# terisolasi untuk StudioFlow. Jangan taruh file/blob di database.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild"

# =============================================================================
# DB POOL — self-hosted/local
# =============================================================================
DB_POOL_MAX="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"
DB_POOL_CONNECTION_TIMEOUT_MS="5000"

# =============================================================================
# AUTH
# =============================================================================
# Set true hanya bila reverse proxy self-hosted memang dipercaya.
AUTH_TRUST_PROXY_CLIENT_IP="false"

# Wajib. Kunci HMAC untuk URL baca aset privat. Minimal 32 karakter, dan TIDAK
# BOLEH memakai nilai contoh - aplikasi menolak start jika belum diisi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Catatan: token sesi TIDAK memakai kunci ini (session memakai randomBytes).
SESSION_SECRET=""

# Absolute path outside the repository's static/public directories.
# Production refuses to start if this is unset, relative, or inside the
# application folder (a re-clone would erase every upload), or not writable.
# The application stores only opaque keys in the database.
STUDIOFLOW_STORAGE_ROOT="D:\StudioFlow\storage"

# STUDIOFLOW_ASSET_SWEEP: on/off; defaults to on in production, off elsewhere.
# STUDIOFLOW_ASSET_SWEEP

# Optional parked cloud adapter. Not required by the local Foundation target.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# TEST (isolated rebuild-only database)
# =============================================================================
PLATFORM_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studioflow_rebuild_test"
