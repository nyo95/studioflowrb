// ============================================================================
// STUDIOFLOW — legacy-behavior rework (STUDIOFLOW-REWORK-CONTRACT.md, SF-R1)
// No foreign keys into platform, master_data, or bq tables. User references
// (pic_designer_id, pic_drafter_id, ...) are plain ids resolved through the
// platform, never through a cross-schema FK.
// ============================================================================
enum SfProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED

  @@map("sf_project_status")
  @@schema("studioflow")
}

enum SfProjectPriority {
  URGENT
  NORMAL
  LOW

  @@map("sf_project_priority")
  @@schema("studioflow")
}

enum SfPhaseStatus {
  PENDING
  ACTIVE
  DONE

  @@map("sf_phase_status")
  @@schema("studioflow")
}

enum SfRevisionStatus {
  NOT_SENT
  SENT
  ANSWERED
  REVISED
  DONE

  @@map("sf_revision_status")
  @@schema("studioflow")
}

enum SfActivityMode {
  FEEDBACK

  @@map("sf_activity_mode")
  @@schema("studioflow")
}

enum SfActivityStatus {
  OPEN
  COMPLETED

  @@map("sf_activity_status")
  @@schema("studioflow")
}

enum SfCdItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("sf_cd_item_status")
  @@schema("studioflow")
}

/// Singleton StudioFlow workflow settings (id = "studio").
model SfSettings {
  id                  String   @id @default("studio")
  archive_retention_days Int   @default(90)
  updated_at          DateTime @updatedAt
  updated_by_id       String?

  @@map("sf_settings")
  @@schema("studioflow")
}

/// Retry ledger for StudioFlow blob deletes. A row is either a key whose delete failed
/// (archive purge, schedule/presentation/MOM image, deliverable delete/prune/expiry, upload
/// rollback) or a key enqueued (attempts = 0) in the same transaction that deleted its last
/// owner row and not yet confirmed removed. The owning row is already gone, so this is the
/// only remaining record; the cleanup sweep retries it until the delete succeeds.
model SfAssetCleanupFailure {
  id              String    @id @default(uuid())
  storage_key     String    @unique
  first_failed_at DateTime  @default(now())
  last_attempt_at DateTime  @default(now())
  attempts        Int       @default(1)
  resolved_at     DateTime?

  @@map("sf_asset_cleanup_failure")
  @@schema("studioflow")
}

model SfClient {
  id               String    @id @default(uuid())
  name             String
  /// Lower-cased trimmed name; case-insensitive uniqueness authority.
  name_key         String    @unique
  address          String?
  logo_storage_key String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  archived_at      DateTime?

  projects SfProject[]

  @@map("sf_client")
  @@schema("studioflow")
}

model SfProject {
  id              String            @id @default(uuid())
  /// Free-text project name (owner, 2026-09-30: no year-number convention).
  name            String            @unique
  client_id       String?
  pic_designer_id String
  pic_drafter_id  String
  opening_date    DateTime?         @db.Date
  /// Gantt/timeline start; overridable, falls back to `created_at`'s date when unset (owner, 2026-09-23).
  timeline_start_date DateTime?     @db.Date
  status          SfProjectStatus   @default(ACTIVE)
  priority        SfProjectPriority @default(NORMAL)
  client_contact  String?
  address         String?
  area            Decimal?          @db.Decimal(12, 2)
  created_by_id   String
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  archived_at     DateTime?
  archived_by_id  String?
  archive_reason  String?
  assets_purged_at DateTime?

  client           SfClient?          @relation(fields: [client_id], references: [id])
  phases           SfPhase[]
  activities       SfActivity[]
  checklist_items  SfChecklistItem[]
  mom_documents    SfMomDocument[]
  schedule_entries SfScheduleEntry[]
  presentation_boards SfPresentationBoard[]
  deliverables     SfDeliverable[]
  phase_events     SfPhaseEvent[]

  @@index([status, archived_at])
  @@index([pic_designer_id])
  @@index([pic_drafter_id])
  @@index([client_id])
  @@map("sf_project")
  @@schema("studioflow")
}

model SfPhase {
  id                String        @id @default(uuid())
  project_id        String
  /// V2-D3/V2-E: the phase definition this phase was created from. Required; a definition that projects use cannot be deleted.
  definition_id     String
  order_index       Int
  status            SfPhaseStatus @default(PENDING)
  is_locked         Boolean       @default(false)
  allow_parallel    Boolean       @default(false)
  /// V2 snapshot: name from phase definition at project creation (never mutated by template edits).
  name_snapshot     String
  /// V2 snapshot: short prefix for revision labels (e.g. "MB", "CD").
  prefix_snapshot   String        @db.VarChar(4)
  /// V2 snapshot: "designer" | "drafter" — who owns this phase.
  seat_snapshot     String
  /// When status last changed; drives "waiting N days".
  status_changed_at DateTime?
  /// One free-text working note; requirements remain separate reminders.
  note              String?
  /// Portfolio Timeline (owner, 2026-09-23): overridable planned start/end; unset falls back to the equal-width sequence split.
  planned_start_date DateTime?    @db.Date
  planned_end_date   DateTime?    @db.Date
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  project         SfProject         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  definition      SfPhaseDefinition @relation(fields: [definition_id], references: [id], onDelete: Restrict)
  revisions       SfRevision[]
  activities      SfActivity[]
  checklist_items SfChecklistItem[]
  deliverables    SfDeliverable[]
  cd_items        SfCdItem[]
  events          SfPhaseEvent[]

  @@unique([project_id, order_index])
  @@map("sf_phase")
  @@schema("studioflow")
}

/// A client-facing iteration. At most one open iteration per phase (partial unique index in migration).
model SfRevision {
  id         String           @id @default(uuid())
  phase_id   String
  major      Int              @default(1)
  name       String
  status     SfRevisionStatus @default(NOT_SENT)
  sent_at    DateTime?
  answered_at DateTime?
  done_at    DateTime?
  /// Supervision visits reuse the iteration history with a dated visit and note.
  visit_date DateTime?        @db.Date
  note       String?
  created_at DateTime         @default(now())

  phase        SfPhase        @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  activities   SfActivity[]
  deliverables SfDeliverable[]
  events       SfPhaseEvent[]

  @@unique([phase_id, major])
  @@index([phase_id, status])
  @@map("sf_revision")
  @@schema("studioflow")
}

model SfActivity {
  id                    String           @id @default(uuid())
  project_id            String
  phase_id              String?
  /// Null = deferred (detached from its revision but still phase-tagged).
  revision_id           String?
  content               String
  // V2-D1: feedback-only; checklist items own to-dos.
  mode                  SfActivityMode   @default(FEEDBACK)
  status                SfActivityStatus @default(OPEN)
  assigned_to_id        String?
  deferred_from_version String?
  /// Date-only.
  due_at                DateTime?        @db.Date
  created_by_id         String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  completed_at          DateTime?

  project  SfProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase    SfPhase?    @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  revision SfRevision? @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@index([phase_id, revision_id, status])
  @@index([assigned_to_id, status])
  @@map("sf_activity")
  @@schema("studioflow")
}

model SfChecklistTemplate {
  id         String      @id @default(uuid())
  /// Null = general (project-level) template; otherwise it seeds phases created from this definition.
  definition_id String?
  label         String
  is_blocking   Boolean  @default(true)
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  definition      SfPhaseDefinition? @relation(fields: [definition_id], references: [id], onDelete: Cascade)
  generated_items SfChecklistItem[]

  @@index([definition_id, is_active, sort_order])
  @@map("sf_checklist_template")
  @@schema("studioflow")
}

model SfChecklistItem {
  id             String    @id @default(uuid())
  project_id     String
  /// Null = a general project requirement.
  phase_id       String?
  /// Depth capped at one level by the service.
  parent_id      String?
  label          String
  is_checked     Boolean   @default(false)
  checked_at     DateTime?
  /// A dismissed reminder remains historically present but no longer appears on cards.
  dismissed_at   DateTime?
  /// False = warning-only (the former SfRequirement); an unticked root item blocks approval only when true.
  is_blocking    Boolean   @default(true)
  sort_order     Int       @default(0)
  template_id    String?
  created_by_id  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  project  SfProject            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase    SfPhase?             @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  parent   SfChecklistItem?     @relation("SfChecklistTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children SfChecklistItem[]    @relation("SfChecklistTree")
  template SfChecklistTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([project_id, phase_id, parent_id])
  @@index([phase_id, is_checked])
  @@index([phase_id, is_blocking, is_checked])
  @@map("sf_checklist_item")
  @@schema("studioflow")
}

model SfCdItem {
  id             String         @id @default(uuid())
  phase_id       String
  drawing_code   String
  drawing_name   String
  status         SfCdItemStatus @default(PENDING)
  assigned_to_id String?
  created_by_id  String
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  phase SfPhase @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  @@index([phase_id])
  @@map("sf_cd_item")
  @@schema("studioflow")
}

// ── SF-V2 Phase Engine additions (contract §4/5/8 V2-D2/D3/D8) ──────────────

/// Office-level phase template — container for SfPhaseDefinition rows (V2-D3).
model SfPhaseTemplate {
  id         String   @id @default(uuid())
  name       String   @unique
  is_default Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  definitions SfPhaseDefinition[]

  @@map("sf_phase_template")
  @@schema("studioflow")
}

/// One row per phase within a template; projects snapshot from this on creation (V2-D3).
model SfPhaseDefinition {
  id             String   @id @default(uuid())
  template_id    String
  name           String
  /// Short prefix for revision labels: "MB", "D", "CD", etc. (≤4 chars; V2-D5).
  prefix         String   @db.VarChar(4)
  order_index    Int
  allow_parallel Boolean  @default(false)
  /// "designer" | "drafter"
  seat           String   @default("designer")
  /// Ordered special iteration kinds, e.g. [{"name":"CD Mall"},{"name":"CD Final"}].
  default_iteration_kinds Json?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  template SfPhaseTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  /// Phases that were created from this definition.
  phases   SfPhase[]
  /// Checklist templates that seed phases created from this definition.
  checklist_templates SfChecklistTemplate[]

  @@unique([template_id, order_index])
  @@map("sf_phase_definition")
  @@schema("studioflow")
}

/// Append-only record of every phase/iteration transition. `auto_created` is
/// the exact row(s) the matching undo must remove again.
model SfPhaseEvent {
  id           String   @id @default(uuid())
  project_id   String
  phase_id     String
  iteration_id String?
  from_state   String?
  to_state     String
  actor_id     String
  occurred_at  DateTime @default(now())
  auto_created Json?
  undone_at    DateTime?
  undone_by_id String?

  project   SfProject  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase     SfPhase    @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  iteration SfRevision? @relation(fields: [iteration_id], references: [id], onDelete: SetNull)

  @@index([project_id, occurred_at])
  @@index([phase_id, occurred_at])
  @@map("sf_phase_event")
  @@schema("studioflow")
}

/// Phase deliverable uploaded file; status computed from revision (V2-D8).
/// status: MISSING (no row), CURRENT (revision_id = active revision), OUTDATED (revision closed).
model SfDeliverable {
  id              String   @id @default(uuid())
  project_id      String
  phase_id        String
  /// The revision when this file was last uploaded; null means pre-revision upload.
  revision_id     String?
  name            String
  storage_key     String
  file_size_bytes Int?
  content_type    String?
  slot_key        String    @default("")
  is_final        Boolean   @default(false)
  finalized_at    DateTime?
  finalized_by_id String?
  expires_at      DateTime?
  expiry_warned_at DateTime?
  created_by_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  project  SfProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase    SfPhase     @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  revision SfRevision? @relation(fields: [revision_id], references: [id], onDelete: SetNull)

  @@index([project_id, phase_id])
  @@index([phase_id, slot_key, created_at, id])
  @@index([expires_at])
  @@map("sf_deliverable")
  @@schema("studioflow")
}

// ── SF-R2 MOM (contract §10; legacy extensions/mom) ─────────────────────────
model SfMomDocument {
  id               String    @id @default(uuid())
  project_id       String
  topic            String    @default("SITE INSPECTION REPORT")
  meeting_date     DateTime  @db.Date
  venue            String?
  attendees        String?
  prepared_by_name String
  created_by_id    String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  project   SfProject       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items     SfMomItem[]
  revisions SfMomRevision[]

  @@index([project_id, meeting_date])
  @@map("sf_mom_document")
  @@schema("studioflow")
}

/// Frozen copy of a MOM (see domain/revisions.ts). Only the newest few are kept;
/// `number` keeps counting so a label is never reused after pruning.
model SfMomRevision {
  id              String   @id @default(uuid())
  document_id     String
  number          Int
  note            String?
  snapshot        Json
  created_by_id   String
  created_by_name String
  created_at      DateTime @default(now())

  document SfMomDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, number])
  @@map("sf_mom_revision")
  @@schema("studioflow")
}

model SfMomItem {
  id           String   @id @default(uuid())
  document_id  String
  sort_order   Int
  is_text_only Boolean  @default(false)
  /// Free-typed notes for this section; list markers (`1.`, `-`, `•`) are
  /// literal characters the user types, not a computed style (§10 rework).
  content      String   @default("")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  document SfMomDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  images   SfMomImage[]

  @@index([document_id, sort_order])
  @@map("sf_mom_item")
  @@schema("studioflow")
}

/// At most two images per item; `slot` is 0 or 1 (legacy two-image layout).
model SfMomImage {
  id           String   @id @default(uuid())
  item_id      String
  slot         Int
  storage_key  String   @unique
  content_type String
  bytes        Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  item SfMomItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, slot])
  @@map("sf_mom_image")
  @@schema("studioflow")
}

// ── SF-R3 Product Schedule (contract §11; legacy extensions/schedule) ──────
enum SfScheduleSection {
  MATERIAL
  FIXTURE

  @@map("sf_schedule_section")
  @@schema("studioflow")
}

enum SfScheduleOptionStatus {
  DRAFT
  APPROVED
  NOT_USED

  @@map("sf_schedule_option_status")
  @@schema("studioflow")
}

model SfSchedulePrefix {
  id           String            @id @default(uuid())
  section      SfScheduleSection
  category     String
  category_key String
  prefix       String
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  @@unique([section, category_key])
  @@map("sf_schedule_prefix")
  @@schema("studioflow")
}

model SfScheduleTemplateCategory {
  id               String            @id @default(uuid())
  section          SfScheduleSection
  category         String
  category_key     String
  is_active        Boolean           @default(true)
  sort_order       Int               @default(0)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  items SfScheduleTemplateItem[]

  @@unique([section, category_key])
  @@index([section, is_active, sort_order])
  @@map("sf_schedule_template_category")
  @@schema("studioflow")
}

model SfScheduleTemplateItem {
  id                   String                      @id @default(uuid())
  template_category_id String?
  section              SfScheduleSection
  category             String
  category_key         String
  brand_id             String?
  brand_name           String?
  product_name         String
  color                String?
  pattern              String?
  finishing            String?
  dimension            String?
  notes                String?
  /** Free-form spec lines as `[{label, value}]`, copied into the option on apply. */
  extra                Json                        @default("[]")
  /** Card-field choice of the row this item was saved from; null = the project default. */
  card_fields          Json?
  image_key            String?
  qty                  Decimal?                    @db.Decimal(12, 2)
  unit                 String?
  location             String?
  is_active            Boolean                     @default(true)
  sort_order           Int                         @default(0)
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt

  template_category SfScheduleTemplateCategory? @relation(fields: [template_category_id], references: [id], onDelete: SetNull)
  entries           SfScheduleEntry[]

  @@index([section, category_key, is_active, sort_order])
  @@map("sf_schedule_template_item")
  @@schema("studioflow")
}

model SfScheduleEntry {
  id              String            @id @default(uuid())
  project_id      String
  section         SfScheduleSection
  category        String
  category_key    String
  prefix          String
  increment       Int
  sort_order      Int
  qty             Decimal?          @db.Decimal(12, 2)
  unit            String?
  location        String?
  /** Board-card field choice; null = no override (SCHEDULE_DEFAULT_CARD_FIELDS), an array = explicit and may be empty. */
  card_fields     Json?
  active_index    Int               @default(0)
  version_locked  Boolean           @default(false)
  template_item_id String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  project       SfProject               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  template_item SfScheduleTemplateItem? @relation(fields: [template_item_id], references: [id], onDelete: SetNull)
  options       SfScheduleOption[]
  presentation_annotations SfPresentationAnnotation[]

  @@unique([project_id, section, prefix, increment], map: "sf_schedule_entry_code_key")
  @@index([project_id, section, category_key, sort_order])
  @@index([template_item_id])
  @@map("sf_schedule_entry")
  @@schema("studioflow")
}

enum SfPresentationLabelSide {
  AUTO  @map("auto")
  LEFT  @map("left")
  RIGHT @map("right")

  @@map("sf_presentation_label_side")
  @@schema("studioflow")
}

/// A project-owned presentation document. Each board holds several rendered-image slides.
model SfPresentationBoard {
  id            String   @id @default(uuid())
  project_id    String
  title         String
  sort_order    Int
  created_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project SfProject               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  slides  SfPresentationSlide[]

  @@index([project_id, sort_order])
  @@map("sf_presentation_board")
  @@schema("studioflow")
}

model SfPresentationSlide {
  id          String   @id @default(uuid())
  board_id    String
  image_key   String   @unique
  image_ratio Float?
  sort_order  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  board       SfPresentationBoard        @relation(fields: [board_id], references: [id], onDelete: Cascade)
  annotations SfPresentationAnnotation[]

  @@index([board_id, sort_order])
  @@map("sf_presentation_slide")
  @@schema("studioflow")
}

model SfPresentationAnnotation {
  id                String                  @id @default(uuid())
  slide_id          String
  schedule_entry_id String?
  pin_x             Float
  pin_y             Float
  label_side        SfPresentationLabelSide @default(AUTO)
  note              String?
  sort_order        Int
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  slide          SfPresentationSlide @relation(fields: [slide_id], references: [id], onDelete: Cascade)
  schedule_entry SfScheduleEntry?    @relation(fields: [schedule_entry_id], references: [id], onDelete: SetNull)

  @@index([slide_id, sort_order])
  @@index([schedule_entry_id])
  @@map("sf_presentation_annotation")
  @@schema("studioflow")
}

model SfScheduleOption {
  id           String                 @id @default(uuid())
  entry_id     String
  label        String
  is_final     Boolean                @default(false)
  status       SfScheduleOptionStatus @default(DRAFT)
  brand_id     String?
  brand_name   String?
  product_name String
  color        String?
  pattern      String?
  finishing    String?
  dimension    String?
  notes        String?
  /** Free-form spec lines as `[{label, value}]`; the typed columns above stay the home of the fields every card carries. */
  extra        Json                   @default("[]")
  image_key    String?
  search_key   String
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  entry SfScheduleEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  sample_requests SfScheduleSampleRequest[]

  @@unique([entry_id, label])
  @@index([search_key])
  @@map("sf_schedule_option")
  @@schema("studioflow")
}

enum SfSampleRequestStatus {
  REQUESTED
  RECEIVED

  @@map("sf_sample_request_status")
  @@schema("studioflow")
}

/// Physical sample request against a Product Schedule option (owner, 2026-09-23).
/// Stays entirely inside StudioFlow — no reference into Master Data's Sku/Vendor
/// tables; `requested_from` is free text, matching how a Schedule option already
/// copies `brand_name` rather than living behind a cross-app foreign key.
model SfScheduleSampleRequest {
  id                String                @id @default(uuid())
  option_id         String
  requested_from    String
  note              String?
  status            SfSampleRequestStatus @default(REQUESTED)
  requested_by_id   String
  requested_by_name String
  requested_at      DateTime              @default(now())
  received_by_id    String?
  received_by_name  String?
  received_at       DateTime?
  received_note     String?
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt

  option SfScheduleOption @relation(fields: [option_id], references: [id], onDelete: Cascade)

  @@index([option_id, created_at])
  @@map("sf_schedule_sample_request")
  @@schema("studioflow")
}
