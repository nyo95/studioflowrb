// ============================================================================
// MASTER DATA — curated first application scope
// ============================================================================
enum UnitStatus {
  ACTIVE
  ARCHIVED

  @@schema("master_data")
}

enum CategoryKind {
  PRODUCT
  WORK

  @@schema("master_data")
}

enum CategoryStatus {
  ACTIVE
  DEACTIVATED

  @@schema("master_data")
}

enum ArchiveCauseKind {
  DIRECT
  PARENT

  @@schema("master_data")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("master_data")
}

enum CategoryOriginKind {
  MANUAL
  SKU_ENRICHMENT

  @@schema("master_data")
}

model Unit {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  status      UnitStatus @default(ACTIVE)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  archived_at DateTime?

  base_skus             Sku[]                @relation("SkuBaseUnit")
  purchase_skus         Sku[]                @relation("SkuPurchaseUnit")
  dimension_skus        Sku[]                @relation("SkuDimensionUnit")
  material_prices       PriceMaterial[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([status])
  @@schema("master_data")
}

model Category {
  id             String         @id @default(uuid())
  name           String
  slug           String
  kind           CategoryKind
  status         CategoryStatus @default(ACTIVE)
  deactivated_at DateTime?
  merged_into_id String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  merged_into           Category?            @relation("CategoryMerge", fields: [merged_into_id], references: [id], onDelete: Restrict)
  merged_from           Category[]           @relation("CategoryMerge")
  brand_categories      BrandCategory[]
  sku_categories        SkuCategory[]
  vendor_categories     VendorCategory[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([kind, status])
  @@index([merged_into_id])
  @@schema("master_data")
}

model VendorType {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  can_supply_material Boolean   @default(false)
  can_supply_labor    Boolean   @default(false)
  sort_order          Int       @default(0)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  vendor_types VendorVendorType[]

  @@index([deleted_at])
  @@schema("master_data")
}

model Vendor {
  id         String    @id @default(uuid())
  name       String
  slug       String
  legal_name String?
  address    String?
  notes      String?
  info_links Json @default("[]")
  link_review_snapshot Json @default("[]")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  types                 VendorVendorType[]
  contacts              VendorContact[]
  owned_brands          Brand[]              @relation("BrandOwner")
  brand_suppliers       BrandSupplier[]
  categories            VendorCategory[]
  material_prices       PriceMaterial[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([deleted_at])
  @@schema("master_data")
}

/// A supplier's trades and product lines, drawn from the one shared Category list (WORK = trade such as MEP,
/// PRODUCT = product line such as Flooring). It replaces the former free-standing SupplierCategory list.
model VendorCategory {
  id          String   @id @default(uuid())
  vendor_id   String
  category_id String
  assigned_at DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([vendor_id, category_id])
  @@index([category_id])
  @@schema("master_data")
}

model VendorVendorType {
  id             String     @id @default(uuid())
  vendor_id      String
  vendor_type_id String
  assigned_at    DateTime   @default(now())
  vendor         Vendor     @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  vendor_type    VendorType @relation(fields: [vendor_type_id], references: [id], onDelete: Restrict)

  @@unique([vendor_id, vendor_type_id])
  @@index([vendor_type_id])
  @@schema("master_data")
}

model VendorContact {
  id          String   @id @default(uuid())
  vendor_id   String
  brand_id    String?
  person_name String
  job_title   String?
  email       String?
  phone       String?
  /// Second and third phone numbers (the first stays in `phone`); at most two.
  extra_phones String[] @default([])
  is_primary  Boolean  @default(false)
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  @@index([vendor_id])
  @@index([brand_id])
  @@schema("master_data")
}

model Brand {
  id              String    @id @default(uuid())
  name            String
  slug            String
  owner_vendor_id String?
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  owner_vendor Vendor?         @relation("BrandOwner", fields: [owner_vendor_id], references: [id], onDelete: Restrict)
  contacts     VendorContact[]
  suppliers    BrandSupplier[]
  links        BrandLink[]
  hashtags     BrandHashtag[]
  categories   BrandCategory[]
  skus         Sku[]

  @@index([deleted_at])
  @@index([owner_vendor_id])
  @@schema("master_data")
}

model BrandSupplier {
  id            String   @id @default(uuid())
  brand_id      String
  vendor_id     String
  is_authorized Boolean  @default(false)
  notes         String?
  created_at    DateTime @default(now())
  brand         Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  vendor        Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, vendor_id])
  @@index([vendor_id])
  @@schema("master_data")
}

model BrandLink {
  id              String          @id @default(uuid())
  brand_id        String
  kind            String
  url             String
  label           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  brand           Brand           @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  material_prices PriceMaterial[]

  @@unique([brand_id, url])
  @@schema("master_data")
}

model BrandHashtag {
  id         String   @id @default(uuid())
  brand_id   String
  label      String
  normalized String
  created_at DateTime @default(now())
  brand      Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, normalized])
  @@index([normalized])
  @@schema("master_data")
}

model BrandCategory {
  id          String                @id @default(uuid())
  brand_id    String
  category_id String
  created_at  DateTime              @default(now())
  brand       Brand                 @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category    Category              @relation(fields: [category_id], references: [id], onDelete: Restrict)
  origins     BrandCategoryOrigin[]

  @@unique([brand_id, category_id])
  @@index([category_id])
  @@schema("master_data")
}

model BrandCategoryOrigin {
  id                String             @id @default(uuid())
  brand_category_id String
  kind              CategoryOriginKind
  source_sku_id     String?
  actor_user_id     String?
  actor_label       String
  created_at        DateTime           @default(now())
  brand_category    BrandCategory      @relation(fields: [brand_category_id], references: [id], onDelete: Restrict)
  source_sku        Sku?               @relation(fields: [source_sku_id], references: [id], onDelete: Restrict)

  @@index([source_sku_id])
  @@index([brand_category_id, kind])
  @@schema("master_data")
}

model Sku {
  id                      String    @id @default(uuid())
  brand_id                String?
  code                    String?
  name                    String?
  slug                    String
  base_unit_id            String
  purchase_unit_id        String?
  dimension_length        Decimal?  @db.Decimal(12, 3)
  dimension_width         Decimal?  @db.Decimal(12, 3)
  dimension_thickness     Decimal?  @db.Decimal(12, 3)
  dimension_unit_id       String?
  purchase_to_base_factor Decimal?  @db.Decimal(18, 6)
  notes                   String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  brand            Brand?                @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  base_unit        Unit                  @relation("SkuBaseUnit", fields: [base_unit_id], references: [id], onDelete: Restrict)
  purchase_unit    Unit?                 @relation("SkuPurchaseUnit", fields: [purchase_unit_id], references: [id], onDelete: Restrict)
  dimension_unit   Unit?                 @relation("SkuDimensionUnit", fields: [dimension_unit_id], references: [id], onDelete: Restrict)
  categories       SkuCategory[]
  material_prices  PriceMaterial[]
  category_origins BrandCategoryOrigin[]
  samples          Sample[]

  @@index([brand_id])
  @@index([base_unit_id])
  @@index([purchase_unit_id])
  @@index([deleted_at])
  @@index([code])
  @@index([dimension_unit_id])
  @@schema("master_data")
}

model SkuCategory {
  id          String   @id @default(uuid())
  sku_id      String
  category_id String
  created_at  DateTime @default(now())
  sku         Sku      @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([sku_id, category_id])
  @@unique([sku_id])
  @@index([category_id])
  @@schema("master_data")
}

model PriceMaterial {
  id                 String    @id @default(uuid())
  sku_id             String
  supplier_vendor_id String
  amount             Decimal   @db.Decimal(16, 2)
  amount_label       String?   @db.VarChar(64)
  currency           String
  unit_id            String
  source_link_id     String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  sku             Sku        @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  supplier_vendor Vendor     @relation(fields: [supplier_vendor_id], references: [id], onDelete: Restrict)
  unit            Unit       @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  source_link     BrandLink? @relation(fields: [source_link_id], references: [id], onDelete: SetNull)

  @@index([sku_id])
  @@index([supplier_vendor_id])
  @@index([unit_id])
  @@index([source_link_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model PriceMaterialLabor {
  id                 String    @id @default(uuid())
  name               String
  slug               String
  category_id        String
  vendor_id          String
  unit_id            String
  amount             Decimal   @db.Decimal(16, 2)
  amount_label       String?   @db.VarChar(64)
  currency           String
  scope_note         String?
  spec               Json?
  dim_display        String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([category_id])
  @@index([vendor_id])
  @@index([unit_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model PriceLabor {
  id                 String    @id @default(uuid())
  name               String
  slug               String
  category_id        String
  vendor_id          String
  unit_id            String
  amount             Decimal   @db.Decimal(16, 2)
  amount_label       String?   @db.VarChar(64)
  currency           String
  spec               Json?
  dim_display        String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([category_id])
  @@index([vendor_id])
  @@index([unit_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model ArchiveCause {
  id          String           @id @default(uuid())
  entity_type String
  entity_id   String
  kind        ArchiveCauseKind
  parent_type String?
  parent_id   String?
  created_at  DateTime         @default(now())

  @@unique([entity_type, entity_id, kind, parent_type, parent_id])
  @@index([entity_type, entity_id])
  @@index([parent_type, parent_id])
  @@schema("master_data")
}

model DeletionRequest {
  id                String                @id @default(uuid())
  target_type       String
  target_id         String
  status            DeletionRequestStatus @default(PENDING)
  requester_user_id String
  requester_label   String
  requested_at      DateTime              @default(now())
  approver_user_id  String?
  approver_label    String?
  decided_at        DateTime?
  reason            String?
  notes             String?

  @@index([target_type, target_id, status])
  @@index([status])
  @@schema("master_data")
}

enum SampleRequestIntakeStatus {
  IN_PROGRESS
  PRICED
  DECLINED

  @@schema("master_data")
}

enum SampleStatus {
  AVAILABLE
  BORROWED
  SENT_TO_CLIENT
  LOST
  DISCARDED

  @@schema("master_data")
}

enum SampleMovementKind {
  IN
  OUT
  RETURN
  STATUS
  MOVED
  REMOVED

  @@schema("master_data")
}

model Sample {
  id                  String       @id @default(uuid())
  sku_id              String
  source_intake_id    String?      @unique
  rack                String
  box                 String
  quantity            Int          @default(1)
  location_note       String?
  notes               String?
  status              SampleStatus @default(AVAILABLE)
  holder_name         String?
  holder_project_id   String?
  holder_project_name String?
  out_since           DateTime?
  deleted_at          DateTime?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  sku       Sku                  @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  intake    SampleRequestIntake? @relation(fields: [source_intake_id], references: [id], onDelete: Restrict)
  movements SampleMovement[]

  @@index([rack, box])
  @@index([status])
  @@index([sku_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model SampleMovement {
  id                  String             @id @default(uuid())
  sample_id           String
  kind                SampleMovementKind
  status_after        SampleStatus
  holder_name         String?
  holder_project_name String?
  from_rack           String?
  from_box            String?
  to_rack             String?
  to_box              String?
  note                String?
  actor_user_id       String
  actor_label         String
  created_at          DateTime           @default(now())

  sample Sample @relation(fields: [sample_id], references: [id], onDelete: Restrict)

  @@index([sample_id, created_at])
  @@schema("master_data")
}

/// Master Data's own record of working a StudioFlow sample request. StudioFlow only asks; this table is
/// where staff take it, note the vendor's quote, and finish it as priced or declined. Every source and
/// reference column is a plain id or a snapshot: there is no foreign key to StudioFlow, and vendor/SKU/price
/// links are ids checked when written, so this row keeps its meaning if either side later changes.
model SampleRequestIntake {
  id                  String                    @id @default(uuid())
  source_request_id   String                    @unique
  source_project_id   String
  source_project_name String
  source_option_id    String
  product_name        String
  brand_name          String?
  color               String?
  pattern             String?
  finishing           String?
  dimension           String?
  requested_from      String
  request_note        String?
  requester_user_id   String
  requester_label     String
  requested_at        DateTime
  status              SampleRequestIntakeStatus @default(IN_PROGRESS)
  vendor_id           String?
  quoted_amount       Decimal?                  @db.Decimal(16, 2)
  quoted_currency     String?
  staff_note          String?
  sku_id              String?
  price_material_id   String?
  handled_by_user_id  String
  handled_by_label    String
  started_at          DateTime                  @default(now())
  resolved_at         DateTime?
  updated_at          DateTime                  @updatedAt

  shelved_sample      Sample?

  @@index([status, started_at])
  @@schema("master_data")
}
