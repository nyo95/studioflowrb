enum SfPresentationLabelSide {
  AUTO  @map("auto")
  LEFT  @map("left")
  RIGHT @map("right")

  @@map("sf_presentation_label_side")
  @@schema("presentation")
}

/// Project and creator identities are plain cross-module snapshots.
model SfPresentationBoard {
  id            String   @id @default(uuid())
  project_id    String
  title         String
  sort_order    Int
  created_by_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  slides SfPresentationSlide[]

  @@index([project_id, sort_order])
  @@map("sf_presentation_board")
  @@schema("presentation")
}

/// A page of a board (owner 2026-10-14, "mini PowerPoint"): a layout of up to four image boxes, an optional title and caption.
model SfPresentationSlide {
  id         String   @id @default(uuid())
  board_id   String
  /// one | two-side | two-stack | one-two | three | four (see `presentation/layouts.ts`).
  layout     String   @default("one")
  title      String?
  caption    String?
  sort_order Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  board  SfPresentationBoard        @relation(fields: [board_id], references: [id], onDelete: Cascade)
  images SfPresentationSlideImage[]

  @@index([board_id, sort_order])
  @@map("sf_presentation_slide")
  @@schema("presentation")
}

/// One image in one box of a slide's layout; pins belong to the image.
model SfPresentationSlideImage {
  id          String   @id @default(uuid())
  slide_id    String
  /// The box of the layout, from 0.
  slot        Int
  image_key   String   @unique
  image_ratio Float?
  /// cover = fills the box (cropped at `focus_x`/`focus_y`, 0-100); contain = the whole image.
  fit         String   @default("cover")
  focus_x     Float    @default(50)
  focus_y     Float    @default(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  slide       SfPresentationSlide        @relation(fields: [slide_id], references: [id], onDelete: Cascade)
  annotations SfPresentationAnnotation[]

  @@unique([slide_id, slot])
  @@map("sf_presentation_slide_image")
  @@schema("presentation")
}

model SfPresentationAnnotation {
  id                String                  @id @default(uuid())
  image_id          String
  /// Live StudioFlow Schedule entry id. Missing entries resolve as unlinked.
  schedule_entry_id String?
  pin_x             Float
  pin_y             Float
  label_side        SfPresentationLabelSide @default(AUTO)
  note              String?
  sort_order        Int
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  image SfPresentationSlideImage @relation(fields: [image_id], references: [id], onDelete: Cascade)

  @@index([image_id, sort_order])
  @@index([schedule_entry_id])
  @@map("sf_presentation_annotation")
  @@schema("presentation")
}

/// Durable retry ledger for slide objects whose owning row has already gone.
model PresentationAssetCleanupFailure {
  id              String    @id @default(uuid())
  storage_key     String    @unique
  attempts        Int       @default(0)
  first_failed_at DateTime  @default(now())
  last_attempt_at DateTime  @default(now())
  resolved_at     DateTime?

  @@index([resolved_at, first_failed_at])
  @@map("asset_cleanup_failure")
  @@schema("presentation")
}
