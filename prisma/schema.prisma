generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "master_data", "bq", "studioflow"]
}

// ============================================================================
// PLATFORM — Identity and access (Foundation F0, CORE.md §3/§4)
// ============================================================================

/// Operational account status. There is no deleted state: accounts are
/// disabled (DISABLED + disabled_at) and restoring is an explicit command.
enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("platform")
}

/// Platform user identity. Email is stored already normalized (trimmed,
/// lowercase); race-safe uniqueness is the unique index itself.
///
/// Password material is only the encoded Argon2id PHC hash — plaintext,
/// session tokens, and hashes never appear in logs, audit rows, or client
/// results. Users are disabled, never hard-deleted, so historical AuditEvent
/// actor references stay readable.
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Canonical normalized email (trimmed, lowercase). Unique index is the
  /// race-safe authority; the application validates format before insert.
  email         String     @unique
  display_name  String
  password_hash String
  status        UserStatus @default(ACTIVE)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  disabled_at DateTime?

  sessions   Session[]
  user_roles UserRole[]

  @@index([status])
  @@schema("platform")
}

/// Access role. `code` is immutable and normalized; rename of `name` and
/// `description` is allowed. Archiving (archived_at) revokes all effective
/// grants and blocks new assignments; there is no hard delete, so
/// UserRole/RolePermission history is never silently destroyed.
model Role {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable normalized role code (e.g. "platform-owner"). Unique index is
  /// the race-safe authority, including archived rows.
  code        String  @unique
  name        String
  description String?
  is_system   Boolean @default(false)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime?

  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@index([archived_at])
  @@schema("platform")
}

/// Unique User × Role assignment. Restrict on both sides: assignment rows are
/// historical facts; users are disabled (never deleted) and roles are archived
/// (never deleted).
model UserRole {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  role_id String @db.Uuid

  assigned_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)
  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([user_id, role_id])
  @@index([role_id])
  @@schema("platform")
}

/// Unique Role × registered permission ID grant. `permission_id` must be a
/// permission in the code-owned registry (application-enforced on write);
/// unknown persisted IDs grant nothing and surface as integrity failures.
model RolePermission {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_id       String @db.Uuid
  permission_id String

  granted_at DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([role_id, permission_id])
  @@index([permission_id])
  @@schema("platform")
}

/// Revocable database session. Only the SHA-256 hash of the opaque browser
/// token is persisted — never the raw token. `token_hash` unique index is the
/// live-lookup authority; user/revocation/expiry indexes support revocation
/// and cleanup.
model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// SHA-256 hex digest of the raw session token. Lookup authority.
  token_hash String @unique
  user_id    String @db.Uuid

  created_at          DateTime  @default(now())
  last_seen_at        DateTime
  idle_expires_at     DateTime
  absolute_expires_at DateTime
  revoked_at          DateTime?

  /// Bounded client metadata (truncated to 255 chars), best-effort only and
  /// never used for authorization.
  user_agent     String?
  client_address String?

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, revoked_at])
  @@index([idle_expires_at])
  @@index([absolute_expires_at])
  @@schema("platform")
}

/// Infrastructure table owned by the login limiter adapter. It is declared so
/// Prisma migration diff sees the platform schema as complete; application code
/// still accesses it only through the limiter boundary.
model LoginRateLimit {
  key    String @id @db.VarChar(255)
  points Int    @default(0)
  expire BigInt?

  @@schema("platform")
}

/// Typed platform General Settings singleton (CORE.md §11). Exactly one row
/// exists: the SQL check constraint below pins the singleton ID, so no
/// application code can create a second settings row.
model PlatformGeneralSettings {
  /// Constant singleton identity, enforced by CHECK (id = 'platform_general_settings').
  id String @id @default("platform_general_settings")

  organization_name String
  app_title         String
  locale            String
  timezone          String
  currency          String
  /// Weekday number the week starts on (0 = Sunday, 1 = Monday).
  week_starts_on    Int
  brand_mark_url    String?
  /// Server-owned Platform asset reference. This is deliberately distinct
  /// from a safe external/site-relative URL and is resolved only at read time.
  brand_mark_storage_key String?

  /// Typed global appearance theme (D-SF-02: Platform owns appearance/theme,
  /// F-C / PF-4). DESIGN.md locks the canonical "light" theme; the SQL CHECK
  /// constraint mirrors the typed union so no other value can be persisted.
  theme String @default("light")

  /// Owner-configured launcher routing (roadmap "configurable main-route
  /// settings"). Both are advisory: an id that is null, unknown, or no
  /// longer accessible to the current user is ignored at read time, never
  /// enforced or validated against the app registry here (Core stays
  /// domain-neutral and never imports app code).
  main_app_id    String?
  landing_app_id String?

  updated_at DateTime @updatedAt

  @@schema("platform")
}

// ============================================================================
// PLATFORM — AuditEvent (append-only, domain-neutral Core envelope)
// ============================================================================

/// Platform-owned append-only persistence of the locked Core audit envelope
/// (CORE.md §5) for every future app. App-specific audit tables are forbidden.
///
/// - entityType/entityId and actor_user_id are polymorphic references with NO
///   foreign keys by contract.
/// - app_id/actor_kind persist as plain strings: the envelope is domain-neutral
///   and must not couple to per-app enum evolution.
/// - changes/metadata follow Core serialization/redaction rules (canonical
///   decimal strings, ISO-8601 UTC instants, no secrets/blobs).
/// - Append-only: no product revert/delete use case exists; retained
///   indefinitely in MVP.
model AuditEvent {
  id String @id @default(uuid())

  app_id      String
  action      String
  entity_type String
  entity_id   String

  actor_kind    String
  actor_user_id String?
  actor_label   String

  occurred_at DateTime @default(now())

  request_id String?
  changes    Json?
  metadata   Json?

  @@index([app_id, entity_type, entity_id, occurred_at])
  @@index([actor_user_id, occurred_at])
  @@index([occurred_at])
  @@schema("platform")
}

// ============================================================================
// MASTER DATA — curated first application scope
// ============================================================================

enum UnitStatus {
  ACTIVE
  ARCHIVED

  @@schema("master_data")
}

enum CategoryKind {
  PRODUCT
  WORK

  @@schema("master_data")
}

enum CategoryStatus {
  ACTIVE
  DEACTIVATED

  @@schema("master_data")
}

enum ArchiveCauseKind {
  DIRECT
  PARENT

  @@schema("master_data")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("master_data")
}

enum CategoryOriginKind {
  MANUAL
  SKU_ENRICHMENT

  @@schema("master_data")
}

model Unit {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  status      UnitStatus @default(ACTIVE)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  archived_at DateTime?

  base_skus             Sku[]                @relation("SkuBaseUnit")
  purchase_skus         Sku[]                @relation("SkuPurchaseUnit")
  dimension_skus        Sku[]                @relation("SkuDimensionUnit")
  material_prices       PriceMaterial[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([status])
  @@schema("master_data")
}

model Category {
  id             String         @id @default(uuid())
  name           String
  slug           String
  kind           CategoryKind
  status         CategoryStatus @default(ACTIVE)
  deactivated_at DateTime?
  merged_into_id String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  merged_into           Category?            @relation("CategoryMerge", fields: [merged_into_id], references: [id], onDelete: Restrict)
  merged_from           Category[]           @relation("CategoryMerge")
  brand_categories      BrandCategory[]
  sku_categories        SkuCategory[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([kind, status])
  @@index([merged_into_id])
  @@schema("master_data")
}

model VendorType {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  can_supply_material Boolean   @default(false)
  can_supply_labor    Boolean   @default(false)
  sort_order          Int       @default(0)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  vendor_types VendorVendorType[]

  @@index([deleted_at])
  @@schema("master_data")
}

model Vendor {
  id         String    @id @default(uuid())
  name       String
  slug       String
  legal_name String?
  address    String?
  notes      String?
  info_links Json @default("[]")
  link_review_snapshot Json @default("[]")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  types                 VendorVendorType[]
  contacts              VendorContact[]
  owned_brands          Brand[]              @relation("BrandOwner")
  brand_suppliers       BrandSupplier[]
  supplier_categories   VendorSupplierCategory[]
  material_prices       PriceMaterial[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([deleted_at])
  @@schema("master_data")
}

model SupplierCategory {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  sort_order Int       @default(0)
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  vendor_supplier_categories VendorSupplierCategory[]

  @@index([deleted_at])
  @@schema("master_data")
}

model VendorSupplierCategory {
  id                   String            @id @default(uuid())
  vendor_id            String
  supplier_category_id String
  assigned_at          DateTime          @default(now())
  vendor               Vendor            @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  supplier_category    SupplierCategory  @relation(fields: [supplier_category_id], references: [id], onDelete: Restrict)

  @@unique([vendor_id, supplier_category_id])
  @@index([supplier_category_id])
  @@schema("master_data")
}

model VendorVendorType {
  id             String     @id @default(uuid())
  vendor_id      String
  vendor_type_id String
  assigned_at    DateTime   @default(now())
  vendor         Vendor     @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  vendor_type    VendorType @relation(fields: [vendor_type_id], references: [id], onDelete: Restrict)

  @@unique([vendor_id, vendor_type_id])
  @@index([vendor_type_id])
  @@schema("master_data")
}

model VendorContact {
  id          String   @id @default(uuid())
  vendor_id   String
  brand_id    String?
  person_name String
  job_title   String?
  email       String?
  phone       String?
  is_primary  Boolean  @default(false)
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  @@index([vendor_id])
  @@index([brand_id])
  @@schema("master_data")
}

model Brand {
  id              String    @id @default(uuid())
  name            String
  slug            String
  owner_vendor_id String?
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  owner_vendor Vendor?         @relation("BrandOwner", fields: [owner_vendor_id], references: [id], onDelete: Restrict)
  contacts     VendorContact[]
  suppliers    BrandSupplier[]
  links        BrandLink[]
  hashtags     BrandHashtag[]
  categories   BrandCategory[]
  skus         Sku[]

  @@index([deleted_at])
  @@index([owner_vendor_id])
  @@schema("master_data")
}

model BrandSupplier {
  id            String   @id @default(uuid())
  brand_id      String
  vendor_id     String
  is_authorized Boolean  @default(false)
  notes         String?
  created_at    DateTime @default(now())
  brand         Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  vendor        Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, vendor_id])
  @@index([vendor_id])
  @@schema("master_data")
}

model BrandLink {
  id              String          @id @default(uuid())
  brand_id        String
  kind            String
  url             String
  label           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  brand           Brand           @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  material_prices PriceMaterial[]

  @@unique([brand_id, url])
  @@schema("master_data")
}

model BrandHashtag {
  id         String   @id @default(uuid())
  brand_id   String
  label      String
  normalized String
  created_at DateTime @default(now())
  brand      Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, normalized])
  @@index([normalized])
  @@schema("master_data")
}

model BrandCategory {
  id          String                @id @default(uuid())
  brand_id    String
  category_id String
  created_at  DateTime              @default(now())
  brand       Brand                 @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category    Category              @relation(fields: [category_id], references: [id], onDelete: Restrict)
  origins     BrandCategoryOrigin[]

  @@unique([brand_id, category_id])
  @@index([category_id])
  @@schema("master_data")
}

model BrandCategoryOrigin {
  id                String             @id @default(uuid())
  brand_category_id String
  kind              CategoryOriginKind
  source_sku_id     String?
  actor_user_id     String?
  actor_label       String
  created_at        DateTime           @default(now())
  brand_category    BrandCategory      @relation(fields: [brand_category_id], references: [id], onDelete: Restrict)
  source_sku        Sku?               @relation(fields: [source_sku_id], references: [id], onDelete: Restrict)

  @@index([source_sku_id])
  @@index([brand_category_id, kind])
  @@schema("master_data")
}

model Sku {
  id                      String    @id @default(uuid())
  brand_id                String?
  code                    String?
  name                    String?
  slug                    String
  base_unit_id            String
  purchase_unit_id        String?
  dimension_length        Decimal?  @db.Decimal(12, 3)
  dimension_width         Decimal?  @db.Decimal(12, 3)
  dimension_thickness     Decimal?  @db.Decimal(12, 3)
  dimension_unit_id       String?
  purchase_to_base_factor Decimal?  @db.Decimal(18, 6)
  notes                   String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  brand            Brand?                @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  base_unit        Unit                  @relation("SkuBaseUnit", fields: [base_unit_id], references: [id], onDelete: Restrict)
  purchase_unit    Unit?                 @relation("SkuPurchaseUnit", fields: [purchase_unit_id], references: [id], onDelete: Restrict)
  dimension_unit   Unit?                 @relation("SkuDimensionUnit", fields: [dimension_unit_id], references: [id], onDelete: Restrict)
  categories       SkuCategory[]
  material_prices  PriceMaterial[]
  category_origins BrandCategoryOrigin[]

  @@index([brand_id])
  @@index([deleted_at])
  @@index([code])
  @@index([dimension_unit_id])
  @@schema("master_data")
}

model SkuCategory {
  id          String   @id @default(uuid())
  sku_id      String
  category_id String
  created_at  DateTime @default(now())
  sku         Sku      @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([sku_id, category_id])
  @@unique([sku_id])
  @@index([category_id])
  @@schema("master_data")
}

model PriceMaterial {
  id                 String    @id @default(uuid())
  sku_id             String
  supplier_vendor_id String
  amount             Decimal   @db.Decimal(16, 2)
  currency           String
  unit_id            String
  source_link_id     String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  sku             Sku        @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  supplier_vendor Vendor     @relation(fields: [supplier_vendor_id], references: [id], onDelete: Restrict)
  unit            Unit       @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  source_link     BrandLink? @relation(fields: [source_link_id], references: [id], onDelete: SetNull)

  @@index([sku_id])
  @@index([supplier_vendor_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model PriceMaterialLabor {
  id                 String    @id @default(uuid())
  name               String
  slug               String
  category_id        String
  vendor_id          String
  unit_id            String
  amount             Decimal   @db.Decimal(16, 2)
  currency           String
  scope_note         String?
  spec               Json?
  dim_display        String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([category_id])
  @@index([vendor_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model PriceLabor {
  id                 String    @id @default(uuid())
  name               String
  slug               String
  category_id        String
  vendor_id          String
  unit_id            String
  amount             Decimal   @db.Decimal(16, 2)
  currency           String
  spec               Json?
  dim_display        String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([category_id])
  @@index([vendor_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model ArchiveCause {
  id          String           @id @default(uuid())
  entity_type String
  entity_id   String
  kind        ArchiveCauseKind
  parent_type String?
  parent_id   String?
  created_at  DateTime         @default(now())

  @@unique([entity_type, entity_id, kind, parent_type, parent_id])
  @@index([entity_type, entity_id])
  @@index([parent_type, parent_id])
  @@schema("master_data")
}

model DeletionRequest {
  id                String                @id @default(uuid())
  target_type       String
  target_id         String
  status            DeletionRequestStatus @default(PENDING)
  requester_user_id String
  requester_label   String
  requested_at      DateTime              @default(now())
  approver_user_id  String?
  approver_label    String?
  decided_at        DateTime?
  reason            String?
  notes             String?

  @@index([target_type, target_id, status])
  @@index([status])
  @@schema("master_data")
}

// ============================================================================
// BQ — Bill of Quantity (app-owned, isolated schema)
// ============================================================================

enum BqPromotionStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED

  @@schema("bq")
}

enum BqProjectStatus {
  ACTIVE
  LOCKED
  ARCHIVED

  @@schema("bq")
}

enum BqProjectDeletionStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("bq")
}

enum BqKategori {
  MATERIAL
  UPAH
  MATERIAL_UPAH
  BIAYA_UMUM
  TRANSPORTASI_AKOMODASI
  ALAT

  @@schema("bq")
}

enum BqLineItemSourceType {
  MASTERDATA
  BQ_LIBRARY
  CUSTOM

  @@schema("bq")
}

// ─── BQ LIBRARY ───────────────────────────────────────────────

model BqLibMaterial {
  id                  String   @id @default(cuid())
  name                String
  purchase_unit       String
  base_unit           String?
  harga               Decimal  @db.Decimal(18, 4)
  currency            String   @default("IDR")
  default_koefisien   Decimal  @default(1) @db.Decimal(18, 6)
  kategori            BqKategori  // hanya boleh MATERIAL
  notes               String?
  promotion_status    BqPromotionStatus @default(DRAFT)
  masterdata_ref_id   String?  // plain ID, bukan FK
  created_by          String   // plain User ID, bukan FK
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_material")
  @@schema("bq")
}

model BqLibLabor {
  id                  String   @id @default(cuid())
  name                String
  purchase_unit       String
  base_unit           String?
  harga               Decimal  @db.Decimal(18, 4)
  currency            String   @default("IDR")
  default_koefisien   Decimal  @default(1) @db.Decimal(18, 6)
  kategori            BqKategori  // hanya boleh UPAH
  notes               String?
  promotion_status    BqPromotionStatus @default(DRAFT)
  masterdata_ref_id   String?
  created_by          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_labor")
  @@schema("bq")
}

model BqLibMaterialLabor {
  id                  String   @id @default(cuid())
  name                String
  purchase_unit       String
  base_unit           String?
  harga               Decimal  @db.Decimal(18, 4)
  currency            String   @default("IDR")
  default_koefisien   Decimal  @default(1) @db.Decimal(18, 6)
  kategori            BqKategori  // hanya boleh MATERIAL_UPAH
  notes               String?
  promotion_status    BqPromotionStatus @default(DRAFT)
  masterdata_ref_id   String?
  created_by          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_material_labor")
  @@schema("bq")
}

// Kategori: Biaya Umum, Transportasi & Akomodasi, Alat
// TIDAK bisa dipromosikan ke Master Data
model BqLibCustomItem {
  id                  String       @id @default(cuid())
  name                String
  purchase_unit       String
  harga               Decimal      @db.Decimal(18, 4)
  currency            String       @default("IDR")
  default_koefisien   Decimal      @default(1) @db.Decimal(18, 6)
  kategori            BqKategori
  notes               String?
  created_by          String
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_custom_item")
  @@schema("bq")
}

// ─── TEMPLATE ─────────────────────────────────────────────────

model BqTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sections    BqTemplateSection[]

  @@map("bq_template")
  @@schema("bq")
}

// Template section — max 2 level: Section (parent_id = null) → Subsection (parent_id → Section).
// Nested lebih dari 2 level tidak didukung oleh UI dan business logic BQ.
// Server action harus menolak creation Subsection yang parent-nya sudah merupakan Subsection.
model BqTemplateSection {
  id            String    @id @default(cuid())
  template_id   String
  template      BqTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  name          String
  parent_id     String?   // null = Section, non-null = Subsection (FK ke BqTemplateSection sendiri)
  parent        BqTemplateSection?  @relation("SectionChildren", fields: [parent_id], references: [id])
  children      BqTemplateSection[] @relation("SectionChildren")
  sort_order    Int       @default(0)
  created_by    String
  created_at    DateTime  @default(now())

  recommendations BqTemplateRecommendation[]

  @@map("bq_template_section")
  @@index([template_id, parent_id, sort_order])
  @@schema("bq")
}

// Pointer dari template section ke library item (live reference, bukan snapshot)
// lib_material_id, lib_labor_id, lib_material_labor_id, lib_custom_item_id:
// hanya satu yang non-null per baris
model BqTemplateRecommendation {
  id                      String    @id @default(cuid())
  template_section_id     String
  template_section        BqTemplateSection @relation(fields: [template_section_id], references: [id], onDelete: Cascade)
  sort_order              Int       @default(0)

  lib_material_id         String?
  lib_material            BqLibMaterial?        @relation(fields: [lib_material_id], references: [id])
  lib_labor_id            String?
  lib_labor               BqLibLabor?           @relation(fields: [lib_labor_id], references: [id])
  lib_material_labor_id   String?
  lib_material_labor      BqLibMaterialLabor?   @relation(fields: [lib_material_labor_id], references: [id])
  lib_custom_item_id      String?
  lib_custom_item         BqLibCustomItem?      @relation(fields: [lib_custom_item_id], references: [id])

  @@map("bq_template_recommendation")
  @@index([template_section_id])
  @@schema("bq")
}

// Assembly Templates are reusable L2 + L3 blueprints. Their lines are copied
// into a project on application; they never become a live dependency of BQ data.
model BqAssemblyTemplate {
  id          String              @id @default(cuid())
  name        String
  description String?
  created_by  String
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  lines       BqAssemblyLine[]

  @@map("bq_assembly_template")
  @@schema("bq")
}

model BqAssemblyLine {
  id                                  String             @id @default(cuid())
  assembly_template_id                String
  assembly_template                   BqAssemblyTemplate @relation(fields: [assembly_template_id], references: [id], onDelete: Cascade)
  source_type                         BqLineItemSourceType
  source_ref_id                       String?
  title_snapshot                      String
  purchase_unit_snapshot              String
  base_unit_snapshot                  String?
  purchase_to_base_factor_snapshot    Decimal?           @db.Decimal(18, 6)
  harga_snapshot                      Decimal            @db.Decimal(18, 4)
  currency_snapshot                   String             @default("IDR")
  kategori                            BqKategori
  qty                                 Decimal            @default(1) @db.Decimal(18, 6)
  koefisien                           Decimal            @default(1) @db.Decimal(18, 6)
  sort_order                          Int                @default(0)
  notes                               String?
  created_at                          DateTime           @default(now())
  updated_at                          DateTime           @updatedAt

  @@map("bq_assembly_line")
  @@index([assembly_template_id, sort_order])
  @@schema("bq")
}

// ─── BQ PROJECT ───────────────────────────────────────────────

model BqProject {
  id           String      @id @default(cuid())
  title        String
  client_name  String
  status       BqProjectStatus @default(ACTIVE)
  external_ref String?
  notes        String?
  created_by   String
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  sections     BqSection[]

  @@map("bq_project")
  @@schema("bq")
}

/// BQ-owned approval state for permanent project deletion. `project_id` is a
/// durable target snapshot rather than a foreign key so the approved request
/// remains auditable after the project itself is removed.
model BqProjectDeletionRequest {
  id                String                  @id @default(cuid())
  project_id        String
  project_title     String
  status            BqProjectDeletionStatus @default(PENDING)
  requester_user_id String
  requester_label   String
  requested_at      DateTime                @default(now())
  approver_user_id  String?
  approver_label    String?
  decided_at        DateTime?
  reason            String?

  @@index([project_id, status])
  @@index([status, requested_at])
  @@map("bq_project_deletion_request")
  @@schema("bq")
}

model BqSection {
  id          String    @id @default(cuid())
  project_id  String
  project     BqProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name        String
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())

  subsections BqSubsection[]
  items       BqItem[]       // L1 items langsung di section (tanpa subsection)

  @@map("bq_section")
  @@index([project_id, sort_order])
  @@schema("bq")
}

model BqSubsection {
  id          String    @id @default(cuid())
  section_id  String
  section     BqSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  name        String
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())

  items       BqItem[]

  @@map("bq_subsection")
  @@index([section_id, sort_order])
  @@schema("bq")
}

// L1 Item
// section_id XOR subsection_id — satu harus non-null, yang lain null
// L1 boleh berdiri sendiri tanpa L2 maupun L3. Saat L1-only, harga_snapshot dan koefisien dipakai untuk kalkulasi.
model BqItem {
  id             String        @id @default(cuid())
  section_id     String?
  section        BqSection?    @relation(fields: [section_id], references: [id], onDelete: Cascade)
  subsection_id  String?
  subsection     BqSubsection? @relation(fields: [subsection_id], references: [id], onDelete: Cascade)
  name           String
  qty            Decimal       @db.Decimal(18, 6)
  unit           String
  harga_snapshot Decimal?      @db.Decimal(18, 4)  // dipakai hanya saat L1 tanpa child
  koefisien      Decimal       @default(1) @db.Decimal(18, 6)  // dipakai hanya saat L1 tanpa child
  markup_l1_pct  Decimal       @default(0) @db.Decimal(6, 4)
  sort_order     Int           @default(0)
  notes          String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  sub_objects    BqSubObject[]
  line_items     BqLineItem[]  // L3 langsung di L1 (tanpa L2)

  @@map("bq_item")
  @@index([section_id, sort_order])
  @@index([subsection_id, sort_order])
  @@schema("bq")
}

// L2 Sub-object (opsional)
model BqSubObject {
  id            String    @id @default(cuid())
  item_id       String
  item          BqItem    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  name          String
  qty_per_l1    Decimal   @db.Decimal(18, 6)
  markup_l2_pct Decimal   @default(0) @db.Decimal(6, 4)
  sort_order    Int       @default(0)
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  line_items    BqLineItem[]

  @@map("bq_sub_object")
  @@index([item_id, sort_order])
  @@schema("bq")
}

// L3 Line Item — terminal, tempat kalkulasi terjadi
// sub_object_id XOR item_id — satu harus non-null, yang lain null
model BqLineItem {
  id                              String       @id @default(cuid())
  sub_object_id                   String?
  sub_object                      BqSubObject? @relation(fields: [sub_object_id], references: [id], onDelete: Cascade)
  item_id                         String?      // L3 langsung di L1 (tanpa L2)
  item                            BqItem?      @relation(fields: [item_id], references: [id], onDelete: Cascade)

  // Snapshot fields — semua plain value, tidak ada FK ke MD
  source_type                     BqLineItemSourceType
  source_ref_id                   String?      // plain ID asal (MD price ID atau Library item ID)
  source_imported_at              DateTime?

  title_snapshot                  String
  purchase_unit_snapshot          String
  base_unit_snapshot              String?
  purchase_to_base_factor_snapshot Decimal?    @db.Decimal(18, 6)  // display only
  source_price_snapshot           Decimal?     @db.Decimal(18, 4)  // immutable baseline from import; null = CUSTOM atau harga tidak tersedia saat import
  harga_snapshot                  Decimal      @db.Decimal(18, 4)
  currency_snapshot               String       @default("IDR")
  kategori                        BqKategori

  // Input estimator
  qty                             Decimal      @db.Decimal(18, 6)
  koefisien                       Decimal      @default(1) @db.Decimal(18, 6)

  sort_order                      Int          @default(0)
  notes                           String?
  created_at                      DateTime     @default(now())
  updated_at                      DateTime     @updatedAt

  @@map("bq_line_item")
  @@index([sub_object_id, sort_order])
  @@index([item_id, sort_order])
  @@schema("bq")
}

// ============================================================================
// STUDIOFLOW — legacy-behavior rework (STUDIOFLOW-REWORK-CONTRACT.md, SF-R1)
// No foreign keys into platform, master_data, or bq tables. User references
// (pic_designer_id, assigned_to_id, ...) are plain ids resolved through the
// platform, never through a cross-schema FK.
// ============================================================================

enum SfProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED

  @@map("sf_project_status")
  @@schema("studioflow")
}

enum SfProjectPriority {
  URGENT
  NORMAL
  LOW

  @@map("sf_project_priority")
  @@schema("studioflow")
}

/// Fixed legacy phase set (contract §5.1). App code, not an administered template.
enum SfPhaseKey {
  MOODBOARD
  LAYOUT
  DESIGN_3D
  CD
  SUPERVISION

  @@map("sf_phase_key")
  @@schema("studioflow")
}

enum SfPhaseStatus {
  PENDING
  IN_PROGRESS
  ON_REVIEW_INTERNAL
  APPROVED_INTERNAL
  ON_REVIEW_CLIENT
  READY_FOR_NEXT
  COMPLETED

  @@map("sf_phase_status")
  @@schema("studioflow")
}

enum SfRevisionStatus {
  ACTIVE
  COMPLETED

  @@map("sf_revision_status")
  @@schema("studioflow")
}

enum SfActivityMode {
  TODO
  FEEDBACK

  @@map("sf_activity_mode")
  @@schema("studioflow")
}

enum SfActivityStatus {
  OPEN
  COMPLETED

  @@map("sf_activity_status")
  @@schema("studioflow")
}

/// Singleton StudioFlow workflow settings (id = "studio").
model SfSettings {
  id                  String   @id @default("studio")
  auto_naming_enabled Boolean  @default(true)
  updated_at          DateTime @updatedAt
  updated_by_id       String?

  @@map("sf_settings")
  @@schema("studioflow")
}

/// Per-year project sequence used by auto naming ("2026-007 Name").
model SfProjectSequence {
  year        Int @id
  last_number Int @default(0)

  @@map("sf_project_sequence")
  @@schema("studioflow")
}

model SfClient {
  id               String    @id @default(uuid())
  name             String
  /// Lower-cased trimmed name; case-insensitive uniqueness authority.
  name_key         String    @unique
  address          String?
  logo_storage_key String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  archived_at      DateTime?

  projects SfProject[]

  @@map("sf_client")
  @@schema("studioflow")
}

model SfProject {
  id              String            @id @default(uuid())
  /// "YYYY-NNN" part of the formatted name.
  project_code    String            @unique
  /// Full formatted name "[Year]-[Number] [Name]".
  name            String            @unique
  client_id       String?
  pic_designer_id String
  pic_drafter_id  String
  opening_date    DateTime?         @db.Date
  project_type    String            @default("RETAIL")
  status          SfProjectStatus   @default(ACTIVE)
  priority        SfProjectPriority @default(NORMAL)
  client_contact  String?
  address         String?
  area            Decimal?          @db.Decimal(12, 2)
  created_by_id   String
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  archived_at     DateTime?
  archived_by_id  String?
  archive_reason  String?

  client           SfClient?          @relation(fields: [client_id], references: [id])
  phases           SfPhase[]
  activities       SfActivity[]
  checklist_items  SfChecklistItem[]
  mom_documents    SfMomDocument[]
  schedule_entries SfScheduleEntry[]
  requirements     SfRequirement[]
  deliverables     SfDeliverable[]

  @@index([status, archived_at])
  @@index([pic_designer_id])
  @@index([pic_drafter_id])
  @@index([client_id])
  @@map("sf_project")
  @@schema("studioflow")
}

model SfPhase {
  id                String        @id @default(uuid())
  project_id        String
  key               SfPhaseKey
  /// V2-D3: FK to SfPhaseDefinition; null for phases created before v2. Replaces key in V2-E.
  definition_id     String?
  order_index       Int
  status            SfPhaseStatus @default(PENDING)
  is_locked         Boolean       @default(false)
  allow_parallel    Boolean       @default(false)
  /// V2 snapshot: name from phase definition at project creation (never mutated by template edits).
  name_snapshot     String        @default("")
  /// V2 snapshot: short prefix for revision labels (e.g. "MB", "CD").
  prefix_snapshot   String        @db.VarChar(4) @default("")
  /// V2 snapshot: "designer" | "drafter" — who owns this phase.
  seat_snapshot     String        @default("designer")
  /// When status last changed; drives "waiting N days".
  status_changed_at DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  project         SfProject         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  definition      SfPhaseDefinition? @relation(fields: [definition_id], references: [id], onDelete: SetNull)
  revisions       SfRevision[]
  activities      SfActivity[]
  checklist_items SfChecklistItem[]
  requirements    SfRequirement[]
  deliverables    SfDeliverable[]

  @@unique([project_id, key])
  @@unique([project_id, order_index])
  @@map("sf_phase")
  @@schema("studioflow")
}

/// At most one ACTIVE revision per phase (partial unique index in migration).
model SfRevision {
  id         String           @id @default(uuid())
  phase_id   String
  major      Int              @default(1)
  minor      Int              @default(0)
  status     SfRevisionStatus @default(ACTIVE)
  created_at DateTime         @default(now())
  closed_at  DateTime?

  phase        SfPhase        @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  activities   SfActivity[]
  deliverables SfDeliverable[]

  @@index([phase_id, status])
  @@map("sf_revision")
  @@schema("studioflow")
}

model SfActivity {
  id                    String           @id @default(uuid())
  project_id            String
  phase_id              String?
  /// Null = deferred (detached from its revision but still phase-tagged).
  revision_id           String?
  content               String
  // V2-D1: FEEDBACK is the only valid mode going forward; TODO kept in enum for legacy rows
  mode                  SfActivityMode   @default(FEEDBACK)
  status                SfActivityStatus @default(OPEN)
  assigned_to_id        String?
  deferred_from_version String?
  /// Date-only.
  due_at                DateTime?        @db.Date
  created_by_id         String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  completed_at          DateTime?

  project  SfProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase    SfPhase?    @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  revision SfRevision? @relation(fields: [revision_id], references: [id], onDelete: Cascade)

  @@index([project_id, status])
  @@index([phase_id, revision_id, status])
  @@index([assigned_to_id, status])
  @@map("sf_activity")
  @@schema("studioflow")
}

model SfChecklistTemplate {
  id         String      @id @default(uuid())
  /// Null = general (project-level) template.
  phase_key  SfPhaseKey?
  label      String
  is_active  Boolean     @default(true)
  sort_order Int         @default(0)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  generated_items SfChecklistItem[]

  @@index([phase_key, is_active, sort_order])
  @@map("sf_checklist_template")
  @@schema("studioflow")
}

model SfChecklistItem {
  id             String    @id @default(uuid())
  project_id     String
  /// Null = general project task.
  phase_id       String?
  /// Depth capped at one level by the service.
  parent_id      String?
  label          String
  is_checked     Boolean   @default(false)
  checked_at     DateTime?
  sort_order     Int       @default(0)
  /// 1 = P1 (highest) … 4 = none.
  priority       Int       @default(4)
  /// Date-only.
  due_at         DateTime? @db.Date
  assigned_to_id String?
  template_id    String?
  created_by_id  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  project  SfProject            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase    SfPhase?             @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  parent   SfChecklistItem?     @relation("SfChecklistTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children SfChecklistItem[]    @relation("SfChecklistTree")
  template SfChecklistTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  labels   SfChecklistItemLabel[]

  @@index([project_id, phase_id, parent_id])
  @@index([phase_id, is_checked])
  @@index([assigned_to_id, is_checked])
  @@map("sf_checklist_item")
  @@schema("studioflow")
}

model SfChecklistLabel {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("neutral")
  created_at DateTime @default(now())

  items SfChecklistItemLabel[]

  @@map("sf_checklist_label")
  @@schema("studioflow")
}

model SfChecklistItemLabel {
  item_id  String
  label_id String

  item  SfChecklistItem  @relation(fields: [item_id], references: [id], onDelete: Cascade)
  label SfChecklistLabel @relation(fields: [label_id], references: [id], onDelete: Cascade)

  @@id([item_id, label_id])
  @@index([label_id])
  @@map("sf_checklist_item_label")
  @@schema("studioflow")
}

model SfChecklistFilterView {
  id         String   @id @default(uuid())
  owner_id   String
  name       String
  query_json Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([owner_id, name])
  @@map("sf_checklist_filter_view")
  @@schema("studioflow")
}

// ── SF-V2 Phase Engine additions (contract §4/5/8 V2-D2/D3/D8) ──────────────

/// Office-level phase template — container for SfPhaseDefinition rows (V2-D3).
model SfPhaseTemplate {
  id         String   @id @default(uuid())
  name       String   @unique
  is_default Boolean  @default(false)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  definitions SfPhaseDefinition[]

  @@map("sf_phase_template")
  @@schema("studioflow")
}

/// One row per phase within a template; projects snapshot from this on creation (V2-D3).
model SfPhaseDefinition {
  id             String   @id @default(uuid())
  template_id    String
  name           String
  /// Short prefix for revision labels: "MB", "D", "CD", etc. (≤4 chars; V2-D5).
  prefix         String   @db.VarChar(4)
  order_index    Int
  allow_parallel Boolean  @default(false)
  /// "designer" | "drafter"
  seat           String   @default("designer")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  template SfPhaseTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  /// Phases that were created from this definition.
  phases   SfPhase[]

  @@unique([template_id, order_index])
  @@map("sf_phase_definition")
  @@schema("studioflow")
}

/// Lightweight project/phase requirement — warning-only, never blocks approval (V2-D2).
model SfRequirement {
  id            String    @id @default(uuid())
  project_id    String
  /// Null = project-wide requirement.
  phase_id      String?
  title         String
  description   String?
  is_met        Boolean   @default(false)
  met_at        DateTime?
  met_by_id     String?
  created_by_id String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  project SfProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase   SfPhase?  @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  @@index([project_id, phase_id])
  @@map("sf_requirement")
  @@schema("studioflow")
}

/// Phase deliverable uploaded file; status computed from revision (V2-D8).
/// status: MISSING (no row), CURRENT (revision_id = active revision), OUTDATED (revision closed).
model SfDeliverable {
  id              String   @id @default(uuid())
  project_id      String
  phase_id        String
  /// The revision when this file was last uploaded; null means pre-revision upload.
  revision_id     String?
  name            String
  storage_key     String
  file_size_bytes Int?
  content_type    String?
  created_by_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  project  SfProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  phase    SfPhase     @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  revision SfRevision? @relation(fields: [revision_id], references: [id], onDelete: SetNull)

  @@index([project_id, phase_id])
  @@map("sf_deliverable")
  @@schema("studioflow")
}

// ── SF-R2 MOM (contract §10; legacy extensions/mom) ─────────────────────────

enum SfMomListStyle {
  DECIMAL
  DISC
  DASH
  NONE

  @@map("sf_mom_list_style")
  @@schema("studioflow")
}

enum SfMomPointStyle {
  DEFAULT
  PLAIN

  @@map("sf_mom_point_style")
  @@schema("studioflow")
}

model SfMomDocument {
  id               String    @id @default(uuid())
  project_id       String
  topic            String    @default("SITE INSPECTION REPORT")
  meeting_date     DateTime  @db.Date
  venue            String?
  attendees        String?
  prepared_by_name String
  created_by_id    String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  project SfProject   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items   SfMomItem[]

  @@index([project_id, meeting_date])
  @@map("sf_mom_document")
  @@schema("studioflow")
}

model SfMomItem {
  id           String         @id @default(uuid())
  document_id  String
  sort_order   Int
  is_text_only Boolean        @default(false)
  list_style   SfMomListStyle @default(DECIMAL)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  document SfMomDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  points   SfMomPoint[]
  images   SfMomImage[]

  @@index([document_id, sort_order])
  @@map("sf_mom_item")
  @@schema("studioflow")
}

model SfMomPoint {
  id         String          @id @default(uuid())
  item_id    String
  sort_order Int
  text       String          @default("")
  style      SfMomPointStyle @default(DEFAULT)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  item SfMomItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id, sort_order])
  @@map("sf_mom_point")
  @@schema("studioflow")
}

/// At most two images per item; `slot` is 0 or 1 (legacy two-image layout).
model SfMomImage {
  id           String   @id @default(uuid())
  item_id      String
  slot         Int
  storage_key  String   @unique
  content_type String
  bytes        Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  item SfMomItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, slot])
  @@map("sf_mom_image")
  @@schema("studioflow")
}

// ── SF-R3 Product Schedule (contract §11; legacy extensions/schedule) ──────

enum SfScheduleSection {
  MATERIAL
  FIXTURE

  @@map("sf_schedule_section")
  @@schema("studioflow")
}

enum SfScheduleOptionStatus {
  DRAFT
  APPROVED
  NOT_USED

  @@map("sf_schedule_option_status")
  @@schema("studioflow")
}

model SfSchedulePrefix {
  id           String            @id @default(uuid())
  section      SfScheduleSection
  category     String
  category_key String
  prefix       String
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  @@unique([section, category_key])
  @@map("sf_schedule_prefix")
  @@schema("studioflow")
}

model SfScheduleTemplateCategory {
  id               String            @id @default(uuid())
  section          SfScheduleSection
  category         String
  category_key     String
  is_default_entry Boolean           @default(false)
  is_active        Boolean           @default(true)
  sort_order       Int               @default(0)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  items SfScheduleTemplateItem[]

  @@unique([section, category_key])
  @@index([section, is_active, sort_order])
  @@map("sf_schedule_template_category")
  @@schema("studioflow")
}

model SfScheduleTemplateItem {
  id                   String                      @id @default(uuid())
  template_category_id String?
  section              SfScheduleSection
  category             String
  category_key         String
  brand_id             String?
  brand_name           String?
  product_name         String
  sku_text             String?
  color                String?
  finishing            String?
  dimension            String?
  notes                String?
  image_key            String?
  qty                  Decimal?                    @db.Decimal(12, 2)
  unit                 String?
  location             String?
  is_active            Boolean                     @default(true)
  sort_order           Int                         @default(0)
  created_at           DateTime                    @default(now())
  updated_at           DateTime                    @updatedAt

  template_category SfScheduleTemplateCategory? @relation(fields: [template_category_id], references: [id], onDelete: SetNull)
  entries           SfScheduleEntry[]

  @@index([section, category_key, is_active, sort_order])
  @@map("sf_schedule_template_item")
  @@schema("studioflow")
}

model SfScheduleEntry {
  id              String            @id @default(uuid())
  project_id      String
  section         SfScheduleSection
  category        String
  category_key    String
  prefix          String
  increment       Int
  sort_order      Int
  qty             Decimal?          @db.Decimal(12, 2)
  unit            String?
  location        String?
  active_index    Int               @default(0)
  version_locked  Boolean           @default(false)
  template_item_id String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  project       SfProject               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  template_item SfScheduleTemplateItem? @relation(fields: [template_item_id], references: [id], onDelete: SetNull)
  options       SfScheduleOption[]

  @@unique([project_id, section, prefix, increment], map: "sf_schedule_entry_code_key")
  @@index([project_id, section, category_key, sort_order])
  @@index([template_item_id])
  @@map("sf_schedule_entry")
  @@schema("studioflow")
}

model SfScheduleOption {
  id           String                 @id @default(uuid())
  entry_id     String
  label        String
  is_final     Boolean                @default(false)
  status       SfScheduleOptionStatus @default(DRAFT)
  brand_id     String?
  brand_name   String?
  product_name String
  sku_text     String?
  color        String?
  finishing    String?
  dimension    String?
  notes        String?
  image_key    String?
  search_key   String
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  entry SfScheduleEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, label])
  @@index([search_key])
  @@map("sf_schedule_option")
  @@schema("studioflow")
}
