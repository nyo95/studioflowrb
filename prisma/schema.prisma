generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "master_data", "bq", "studioflow"]
}

// ============================================================================
// PLATFORM — Identity and access (Foundation F0, CORE.md §3/§4)
// ============================================================================

/// Operational account status. There is no deleted state: accounts are
/// disabled (DISABLED + disabled_at) and restoring is an explicit command.
enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("platform")
}

/// Platform user identity. Email is stored already normalized (trimmed,
/// lowercase); race-safe uniqueness is the unique index itself.
///
/// Password material is only the encoded Argon2id PHC hash — plaintext,
/// session tokens, and hashes never appear in logs, audit rows, or client
/// results. Users are disabled, never hard-deleted, so historical AuditEvent
/// actor references stay readable.
model User {
  id String @id @default(uuid())

  /// Canonical normalized email (trimmed, lowercase). Unique index is the
  /// race-safe authority; the application validates format before insert.
  email         String     @unique
  display_name  String
  password_hash String
  status        UserStatus @default(ACTIVE)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  disabled_at DateTime?

  sessions   Session[]
  user_roles UserRole[]

  @@index([status])
  @@schema("platform")
}

/// Access role. `code` is immutable and normalized; rename of `name` and
/// `description` is allowed. Archiving (archived_at) revokes all effective
/// grants and blocks new assignments; there is no hard delete, so
/// UserRole/RolePermission history is never silently destroyed.
model Role {
  id String @id @default(uuid())

  /// Immutable normalized role code (e.g. "platform-owner"). Unique index is
  /// the race-safe authority, including archived rows.
  code        String  @unique
  name        String
  description String?
  is_system   Boolean @default(false)

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  archived_at DateTime?

  user_roles       UserRole[]
  role_permissions RolePermission[]

  @@index([archived_at])
  @@schema("platform")
}

/// Unique User × Role assignment. Restrict on both sides: assignment rows are
/// historical facts; users are disabled (never deleted) and roles are archived
/// (never deleted).
model UserRole {
  id      String @id @default(uuid())
  user_id String
  role_id String

  assigned_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)
  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([user_id, role_id])
  @@index([role_id])
  @@schema("platform")
}

/// Unique Role × registered permission ID grant. `permission_id` must be a
/// permission in the code-owned registry (application-enforced on write);
/// unknown persisted IDs grant nothing and surface as integrity failures.
model RolePermission {
  id            String @id @default(uuid())
  role_id       String
  permission_id String

  granted_at DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([role_id, permission_id])
  @@index([permission_id])
  @@schema("platform")
}

/// Revocable database session. Only the SHA-256 hash of the opaque browser
/// token is persisted — never the raw token. `token_hash` unique index is the
/// live-lookup authority; user/revocation/expiry indexes support revocation
/// and cleanup.
model Session {
  id String @id @default(uuid())

  /// SHA-256 hex digest of the raw session token. Lookup authority.
  token_hash String @unique
  user_id    String

  created_at          DateTime  @default(now())
  last_seen_at        DateTime
  idle_expires_at     DateTime
  absolute_expires_at DateTime
  revoked_at          DateTime?

  /// Bounded client metadata (truncated to 255 chars), best-effort only and
  /// never used for authorization.
  user_agent     String?
  client_address String?

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, revoked_at])
  @@index([idle_expires_at])
  @@index([absolute_expires_at])
  @@schema("platform")
}

/// Typed platform General Settings singleton (CORE.md §11). Exactly one row
/// exists: the SQL check constraint below pins the singleton ID, so no
/// application code can create a second settings row.
model PlatformGeneralSettings {
  /// Constant singleton identity, enforced by CHECK (id = 'platform_general_settings').
  id String @id @default("platform_general_settings")

  organization_name String
  app_title         String
  locale            String
  timezone          String
  currency          String
  /// Weekday number the week starts on (0 = Sunday, 1 = Monday).
  week_starts_on    Int
  brand_mark_url    String?

  updated_at DateTime @updatedAt

  @@schema("platform")
}

// ============================================================================
// PLATFORM — AuditEvent (append-only, domain-neutral Core envelope)
// ============================================================================

/// Platform-owned append-only persistence of the locked Core audit envelope
/// (CORE.md §5) for every future app. App-specific audit tables are forbidden.
///
/// - entityType/entityId and actor_user_id are polymorphic references with NO
///   foreign keys by contract.
/// - app_id/actor_kind persist as plain strings: the envelope is domain-neutral
///   and must not couple to per-app enum evolution.
/// - changes/metadata follow Core serialization/redaction rules (canonical
///   decimal strings, ISO-8601 UTC instants, no secrets/blobs).
/// - Append-only: no product revert/delete use case exists; retained
///   indefinitely in MVP.
model AuditEvent {
  id String @id @default(uuid())

  app_id      String
  action      String
  entity_type String
  entity_id   String

  actor_kind    String
  actor_user_id String?
  actor_label   String

  occurred_at DateTime @default(now())

  request_id String?
  changes    Json?
  metadata   Json?

  @@index([app_id, entity_type, entity_id, occurred_at])
  @@index([actor_user_id, occurred_at])
  @@index([occurred_at])
  @@schema("platform")
}

// ============================================================================
// MASTER DATA — curated first application scope
// ============================================================================

enum UnitStatus {
  ACTIVE
  ARCHIVED

  @@schema("master_data")
}

enum CategoryKind {
  PRODUCT
  WORK

  @@schema("master_data")
}

enum CategoryStatus {
  ACTIVE
  DEACTIVATED

  @@schema("master_data")
}

enum ArchiveCauseKind {
  DIRECT
  PARENT

  @@schema("master_data")
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("master_data")
}

enum CategoryOriginKind {
  MANUAL
  SKU_ENRICHMENT

  @@schema("master_data")
}

model Unit {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  status      UnitStatus @default(ACTIVE)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  archived_at DateTime?

  base_skus             Sku[]                @relation("SkuBaseUnit")
  purchase_skus         Sku[]                @relation("SkuPurchaseUnit")
  dimension_skus        Sku[]                @relation("SkuDimensionUnit")
  material_prices       PriceMaterial[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([status])
  @@schema("master_data")
}

model Category {
  id             String         @id @default(uuid())
  name           String
  slug           String
  kind           CategoryKind
  status         CategoryStatus @default(ACTIVE)
  deactivated_at DateTime?
  merged_into_id String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  merged_into           Category?            @relation("CategoryMerge", fields: [merged_into_id], references: [id], onDelete: Restrict)
  merged_from           Category[]           @relation("CategoryMerge")
  brand_categories      BrandCategory[]
  sku_categories        SkuCategory[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([kind, status])
  @@index([merged_into_id])
  @@schema("master_data")
}

model VendorType {
  id                  String    @id @default(uuid())
  code                String    @unique
  name                String
  can_supply_material Boolean   @default(false)
  can_supply_labor    Boolean   @default(false)
  sort_order          Int       @default(0)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  vendor_types VendorVendorType[]

  @@index([deleted_at])
  @@schema("master_data")
}

model Vendor {
  id         String    @id @default(uuid())
  name       String
  slug       String
  legal_name String?
  address    String?
  notes      String?
  info_links Json @default("[]")
  link_review_snapshot Json @default("[]")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  types                 VendorVendorType[]
  contacts              VendorContact[]
  owned_brands          Brand[]              @relation("BrandOwner")
  brand_suppliers       BrandSupplier[]
  material_prices       PriceMaterial[]
  material_labor_prices PriceMaterialLabor[]
  labor_prices          PriceLabor[]

  @@index([deleted_at])
  @@schema("master_data")
}

model VendorVendorType {
  id             String     @id @default(uuid())
  vendor_id      String
  vendor_type_id String
  assigned_at    DateTime   @default(now())
  vendor         Vendor     @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  vendor_type    VendorType @relation(fields: [vendor_type_id], references: [id], onDelete: Restrict)

  @@unique([vendor_id, vendor_type_id])
  @@index([vendor_type_id])
  @@schema("master_data")
}

model VendorContact {
  id          String   @id @default(uuid())
  vendor_id   String
  brand_id    String?
  person_name String
  job_title   String?
  email       String?
  phone       String?
  is_primary  Boolean  @default(false)
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  @@index([vendor_id])
  @@index([brand_id])
  @@schema("master_data")
}

model Brand {
  id              String    @id @default(uuid())
  name            String
  slug            String
  owner_vendor_id String?
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  owner_vendor Vendor?         @relation("BrandOwner", fields: [owner_vendor_id], references: [id], onDelete: Restrict)
  contacts     VendorContact[]
  suppliers    BrandSupplier[]
  links        BrandLink[]
  hashtags     BrandHashtag[]
  categories   BrandCategory[]
  skus         Sku[]

  @@index([deleted_at])
  @@index([owner_vendor_id])
  @@schema("master_data")
}

model BrandSupplier {
  id            String   @id @default(uuid())
  brand_id      String
  vendor_id     String
  is_authorized Boolean  @default(false)
  notes         String?
  created_at    DateTime @default(now())
  brand         Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  vendor        Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, vendor_id])
  @@index([vendor_id])
  @@schema("master_data")
}

model BrandLink {
  id              String          @id @default(uuid())
  brand_id        String
  kind            String
  url             String
  label           String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  brand           Brand           @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  material_prices PriceMaterial[]

  @@unique([brand_id, url])
  @@schema("master_data")
}

model BrandHashtag {
  id         String   @id @default(uuid())
  brand_id   String
  label      String
  normalized String
  created_at DateTime @default(now())
  brand      Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)

  @@unique([brand_id, normalized])
  @@index([normalized])
  @@schema("master_data")
}

model BrandCategory {
  id          String                @id @default(uuid())
  brand_id    String
  category_id String
  created_at  DateTime              @default(now())
  brand       Brand                 @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category    Category              @relation(fields: [category_id], references: [id], onDelete: Restrict)
  origins     BrandCategoryOrigin[]

  @@unique([brand_id, category_id])
  @@index([category_id])
  @@schema("master_data")
}

model BrandCategoryOrigin {
  id                String             @id @default(uuid())
  brand_category_id String
  kind              CategoryOriginKind
  source_sku_id     String?
  actor_user_id     String?
  actor_label       String
  created_at        DateTime           @default(now())
  brand_category    BrandCategory      @relation(fields: [brand_category_id], references: [id], onDelete: Restrict)
  source_sku        Sku?               @relation(fields: [source_sku_id], references: [id], onDelete: Restrict)

  @@index([source_sku_id])
  @@index([brand_category_id, kind])
  @@schema("master_data")
}

model Sku {
  id                      String    @id @default(uuid())
  brand_id                String?
  code                    String?
  name                    String?
  slug                    String
  base_unit_id            String
  purchase_unit_id        String?
  dimension_length        Decimal?  @db.Decimal(12, 3)
  dimension_width         Decimal?  @db.Decimal(12, 3)
  dimension_thickness     Decimal?  @db.Decimal(12, 3)
  dimension_unit_id       String?
  purchase_to_base_factor Decimal?  @db.Decimal(18, 6)
  notes                   String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  brand            Brand?                @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  base_unit        Unit                  @relation("SkuBaseUnit", fields: [base_unit_id], references: [id], onDelete: Restrict)
  purchase_unit    Unit?                 @relation("SkuPurchaseUnit", fields: [purchase_unit_id], references: [id], onDelete: Restrict)
  dimension_unit   Unit?                 @relation("SkuDimensionUnit", fields: [dimension_unit_id], references: [id], onDelete: Restrict)
  categories       SkuCategory[]
  material_prices  PriceMaterial[]
  category_origins BrandCategoryOrigin[]

  @@index([brand_id])
  @@index([deleted_at])
  @@index([code])
  @@index([dimension_unit_id])
  @@schema("master_data")
}

model SkuCategory {
  id          String   @id @default(uuid())
  sku_id      String
  category_id String
  created_at  DateTime @default(now())
  sku         Sku      @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([sku_id, category_id])
  @@unique([sku_id])
  @@index([category_id])
  @@schema("master_data")
}

model PriceMaterial {
  id                 String    @id @default(uuid())
  sku_id             String
  supplier_vendor_id String
  amount             Decimal   @db.Decimal(16, 2)
  currency           String
  unit_id            String
  source_link_id     String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  sku             Sku        @relation(fields: [sku_id], references: [id], onDelete: Restrict)
  supplier_vendor Vendor     @relation(fields: [supplier_vendor_id], references: [id], onDelete: Restrict)
  unit            Unit       @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  source_link     BrandLink? @relation(fields: [source_link_id], references: [id], onDelete: SetNull)

  @@index([sku_id])
  @@index([supplier_vendor_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model PriceMaterialLabor {
  id                 String    @id @default(uuid())
  name               String
  slug               String
  category_id        String
  vendor_id          String
  unit_id            String
  amount             Decimal   @db.Decimal(16, 2)
  currency           String
  scope_note         String?
  spec               Json?
  dim_display        String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([category_id])
  @@index([vendor_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model PriceLabor {
  id                 String    @id @default(uuid())
  name               String
  slug               String
  category_id        String
  vendor_id          String
  unit_id            String
  amount             Decimal   @db.Decimal(16, 2)
  currency           String
  spec               Json?
  dim_display        String?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  updated_by_user_id String?
  updated_by_label   String

  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor   Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  unit     Unit     @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([category_id])
  @@index([vendor_id])
  @@index([deleted_at])
  @@schema("master_data")
}

model ArchiveCause {
  id          String           @id @default(uuid())
  entity_type String
  entity_id   String
  kind        ArchiveCauseKind
  parent_type String?
  parent_id   String?
  created_at  DateTime         @default(now())

  @@unique([entity_type, entity_id, kind, parent_type, parent_id])
  @@index([entity_type, entity_id])
  @@index([parent_type, parent_id])
  @@schema("master_data")
}

model DeletionRequest {
  id                String                @id @default(uuid())
  target_type       String
  target_id         String
  status            DeletionRequestStatus @default(PENDING)
  requester_user_id String
  requester_label   String
  requested_at      DateTime              @default(now())
  approver_user_id  String?
  approver_label    String?
  decided_at        DateTime?
  reason            String?
  notes             String?

  @@index([target_type, target_id, status])
  @@index([status])
  @@schema("master_data")
}

// ============================================================================
// BQ — Bill of Quantity (app-owned, isolated schema)
// ============================================================================

enum BqPromotionStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED

  @@schema("bq")
}

enum BqProjectStatus {
  ACTIVE
  LOCKED
  ARCHIVED

  @@schema("bq")
}

enum BqProjectDeletionStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("bq")
}

enum BqKategori {
  MATERIAL
  UPAH
  MATERIAL_UPAH
  BIAYA_UMUM
  TRANSPORTASI_AKOMODASI
  ALAT

  @@schema("bq")
}

enum BqLineItemSourceType {
  MASTERDATA
  BQ_LIBRARY
  CUSTOM

  @@schema("bq")
}

// ─── BQ LIBRARY ───────────────────────────────────────────────

model BqLibMaterial {
  id                  String   @id @default(cuid())
  name                String
  purchase_unit       String
  base_unit           String?
  harga               Decimal  @db.Decimal(18, 4)
  currency            String   @default("IDR")
  default_koefisien   Decimal  @default(1) @db.Decimal(18, 6)
  kategori            BqKategori  // hanya boleh MATERIAL
  notes               String?
  promotion_status    BqPromotionStatus @default(DRAFT)
  masterdata_ref_id   String?  // plain ID, bukan FK
  created_by          String   // plain User ID, bukan FK
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_material")
  @@schema("bq")
}

model BqLibLabor {
  id                  String   @id @default(cuid())
  name                String
  purchase_unit       String
  base_unit           String?
  harga               Decimal  @db.Decimal(18, 4)
  currency            String   @default("IDR")
  default_koefisien   Decimal  @default(1) @db.Decimal(18, 6)
  kategori            BqKategori  // hanya boleh UPAH
  notes               String?
  promotion_status    BqPromotionStatus @default(DRAFT)
  masterdata_ref_id   String?
  created_by          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_labor")
  @@schema("bq")
}

model BqLibMaterialLabor {
  id                  String   @id @default(cuid())
  name                String
  purchase_unit       String
  base_unit           String?
  harga               Decimal  @db.Decimal(18, 4)
  currency            String   @default("IDR")
  default_koefisien   Decimal  @default(1) @db.Decimal(18, 6)
  kategori            BqKategori  // hanya boleh MATERIAL_UPAH
  notes               String?
  promotion_status    BqPromotionStatus @default(DRAFT)
  masterdata_ref_id   String?
  created_by          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_material_labor")
  @@schema("bq")
}

// Kategori: Biaya Umum, Transportasi & Akomodasi, Alat
// TIDAK bisa dipromosikan ke Master Data
model BqLibCustomItem {
  id                  String       @id @default(cuid())
  name                String
  purchase_unit       String
  harga               Decimal      @db.Decimal(18, 4)
  currency            String       @default("IDR")
  default_koefisien   Decimal      @default(1) @db.Decimal(18, 6)
  kategori            BqKategori
  notes               String?
  created_by          String
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  template_recommendations BqTemplateRecommendation[]

  @@map("bq_lib_custom_item")
  @@schema("bq")
}

// ─── TEMPLATE ─────────────────────────────────────────────────

model BqTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sections    BqTemplateSection[]

  @@map("bq_template")
  @@schema("bq")
}

// Template section — max 2 level: Section (parent_id = null) → Subsection (parent_id → Section).
// Nested lebih dari 2 level tidak didukung oleh UI dan business logic BQ.
// Server action harus menolak creation Subsection yang parent-nya sudah merupakan Subsection.
model BqTemplateSection {
  id            String    @id @default(cuid())
  template_id   String
  template      BqTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  name          String
  parent_id     String?   // null = Section, non-null = Subsection (FK ke BqTemplateSection sendiri)
  parent        BqTemplateSection?  @relation("SectionChildren", fields: [parent_id], references: [id])
  children      BqTemplateSection[] @relation("SectionChildren")
  sort_order    Int       @default(0)
  created_by    String
  created_at    DateTime  @default(now())

  recommendations BqTemplateRecommendation[]

  @@map("bq_template_section")
  @@schema("bq")
}

// Pointer dari template section ke library item (live reference, bukan snapshot)
// lib_material_id, lib_labor_id, lib_material_labor_id, lib_custom_item_id:
// hanya satu yang non-null per baris
model BqTemplateRecommendation {
  id                      String    @id @default(cuid())
  template_section_id     String
  template_section        BqTemplateSection @relation(fields: [template_section_id], references: [id], onDelete: Cascade)
  sort_order              Int       @default(0)

  lib_material_id         String?
  lib_material            BqLibMaterial?        @relation(fields: [lib_material_id], references: [id])
  lib_labor_id            String?
  lib_labor               BqLibLabor?           @relation(fields: [lib_labor_id], references: [id])
  lib_material_labor_id   String?
  lib_material_labor      BqLibMaterialLabor?   @relation(fields: [lib_material_labor_id], references: [id])
  lib_custom_item_id      String?
  lib_custom_item         BqLibCustomItem?      @relation(fields: [lib_custom_item_id], references: [id])

  @@map("bq_template_recommendation")
  @@schema("bq")
}

// Assembly Templates are reusable L2 + L3 blueprints. Their lines are copied
// into a project on application; they never become a live dependency of BQ data.
model BqAssemblyTemplate {
  id          String              @id @default(cuid())
  name        String
  description String?
  created_by  String
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  lines       BqAssemblyLine[]

  @@map("bq_assembly_template")
  @@schema("bq")
}

model BqAssemblyLine {
  id                                  String             @id @default(cuid())
  assembly_template_id                String
  assembly_template                   BqAssemblyTemplate @relation(fields: [assembly_template_id], references: [id], onDelete: Cascade)
  source_type                         BqLineItemSourceType
  source_ref_id                       String?
  title_snapshot                      String
  purchase_unit_snapshot              String
  base_unit_snapshot                  String?
  purchase_to_base_factor_snapshot    Decimal?           @db.Decimal(18, 6)
  harga_snapshot                      Decimal            @db.Decimal(18, 4)
  currency_snapshot                   String             @default("IDR")
  kategori                            BqKategori
  qty                                 Decimal            @default(1) @db.Decimal(18, 6)
  koefisien                           Decimal            @default(1) @db.Decimal(18, 6)
  sort_order                          Int                @default(0)
  notes                               String?
  created_at                          DateTime           @default(now())
  updated_at                          DateTime           @updatedAt

  @@map("bq_assembly_line")
  @@index([assembly_template_id, sort_order])
  @@schema("bq")
}

// ─── BQ PROJECT ───────────────────────────────────────────────

model BqProject {
  id           String      @id @default(cuid())
  title        String
  client_name  String
  status       BqProjectStatus @default(ACTIVE)
  external_ref String?
  notes        String?
  created_by   String
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  sections     BqSection[]

  @@map("bq_project")
  @@schema("bq")
}

/// BQ-owned approval state for permanent project deletion. `project_id` is a
/// durable target snapshot rather than a foreign key so the approved request
/// remains auditable after the project itself is removed.
model BqProjectDeletionRequest {
  id                String                  @id @default(cuid())
  project_id        String
  project_title     String
  status            BqProjectDeletionStatus @default(PENDING)
  requester_user_id String
  requester_label   String
  requested_at      DateTime                @default(now())
  approver_user_id  String?
  approver_label    String?
  decided_at        DateTime?
  reason            String?

  @@index([project_id, status])
  @@index([status, requested_at])
  @@map("bq_project_deletion_request")
  @@schema("bq")
}

model BqSection {
  id          String    @id @default(cuid())
  project_id  String
  project     BqProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  name        String
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())

  subsections BqSubsection[]
  items       BqItem[]       // L1 items langsung di section (tanpa subsection)

  @@map("bq_section")
  @@schema("bq")
}

model BqSubsection {
  id          String    @id @default(cuid())
  section_id  String
  section     BqSection @relation(fields: [section_id], references: [id], onDelete: Cascade)
  name        String
  sort_order  Int       @default(0)
  created_at  DateTime  @default(now())

  items       BqItem[]

  @@map("bq_subsection")
  @@schema("bq")
}

// L1 Item
// section_id XOR subsection_id — satu harus non-null, yang lain null
// L1 boleh berdiri sendiri tanpa L2 maupun L3. Saat L1-only, harga_snapshot dan koefisien dipakai untuk kalkulasi.
model BqItem {
  id             String        @id @default(cuid())
  section_id     String?
  section        BqSection?    @relation(fields: [section_id], references: [id], onDelete: Cascade)
  subsection_id  String?
  subsection     BqSubsection? @relation(fields: [subsection_id], references: [id], onDelete: Cascade)
  name           String
  qty            Decimal       @db.Decimal(18, 6)
  unit           String
  harga_snapshot Decimal?      @db.Decimal(18, 4)  // dipakai hanya saat L1 tanpa child
  koefisien      Decimal       @default(1) @db.Decimal(18, 6)  // dipakai hanya saat L1 tanpa child
  markup_l1_pct  Decimal       @default(0) @db.Decimal(6, 4)
  sort_order     Int           @default(0)
  notes          String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  sub_objects    BqSubObject[]
  line_items     BqLineItem[]  // L3 langsung di L1 (tanpa L2)

  @@map("bq_item")
  @@schema("bq")
}

// L2 Sub-object (opsional)
model BqSubObject {
  id            String    @id @default(cuid())
  item_id       String
  item          BqItem    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  name          String
  qty_per_l1    Decimal   @db.Decimal(18, 6)
  markup_l2_pct Decimal   @default(0) @db.Decimal(6, 4)
  sort_order    Int       @default(0)
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  line_items    BqLineItem[]

  @@map("bq_sub_object")
  @@schema("bq")
}

// L3 Line Item — terminal, tempat kalkulasi terjadi
// sub_object_id XOR item_id — satu harus non-null, yang lain null
model BqLineItem {
  id                              String       @id @default(cuid())
  sub_object_id                   String?
  sub_object                      BqSubObject? @relation(fields: [sub_object_id], references: [id], onDelete: Cascade)
  item_id                         String?      // L3 langsung di L1 (tanpa L2)
  item                            BqItem?      @relation(fields: [item_id], references: [id], onDelete: Cascade)

  // Snapshot fields — semua plain value, tidak ada FK ke MD
  source_type                     BqLineItemSourceType
  source_ref_id                   String?      // plain ID asal (MD price ID atau Library item ID)
  source_imported_at              DateTime?

  title_snapshot                  String
  purchase_unit_snapshot          String
  base_unit_snapshot              String?
  purchase_to_base_factor_snapshot Decimal?    @db.Decimal(18, 6)  // display only
  source_price_snapshot           Decimal?     @db.Decimal(18, 4)  // immutable baseline from import; null = CUSTOM atau harga tidak tersedia saat import
  harga_snapshot                  Decimal      @db.Decimal(18, 4)
  currency_snapshot               String       @default("IDR")
  kategori                        BqKategori

  // Input estimator
  qty                             Decimal      @db.Decimal(18, 6)
  koefisien                       Decimal      @default(1) @db.Decimal(18, 6)

  sort_order                      Int          @default(0)
  notes                           String?
  created_at                      DateTime     @default(now())
  updated_at                      DateTime     @updatedAt

  @@map("bq_line_item")
  @@schema("bq")
}

// ============================================================================
// STUDIOFLOW — Project management app (SF-WO-2)
// No foreign keys into platform, master_data, or bq tables.
// Cross-schema user references (lead_user_id, closed_by_id, etc.) are plain
// String? columns — app resolves them via platform service, never via FK.
// ============================================================================

enum SfProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED

  @@map("sf_project_status")
  @@schema("studioflow")
}

enum SfPhaseState {
  NOT_STARTED
  IN_PROGRESS
  WAITING_CLIENT
  DONE

  @@map("sf_phase_state")
  @@schema("studioflow")
}

enum SfPhaseClosureKind {
  NORMAL
  EXCEPTION

  @@map("sf_phase_closure_kind")
  @@schema("studioflow")
}

enum SfTaskStatus {
  OPEN
  DONE

  @@map("sf_task_status")
  @@schema("studioflow")
}

/// Studio phase template — the ordered list of phases for new projects.
/// key is stable and immutable once any project snapshot uses it.
model SfPhaseTemplate {
  id           String  @id @default(uuid())
  key          String  @unique
  name         String
  sort_order   Int
  has_rounds   Boolean @default(true)

  /// Label prefix for round headings when has_rounds is true (e.g. "MB", "D", "CD").
  round_prefix String?

  /// Which output folder this phase owns (used in file-naming, SF-WO-3).
  folder_key   String?

  /// When true, Send action warns if no internal approval exists (SF-WO-4).
  requires_internal_approval Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  phases SfProjectPhase[]

  @@map("sf_phase_template")
  @@schema("studioflow")
}

/// A StudioFlow Client — paying counterparty of a project.
/// Independent of Master Data; no FK into master_data schema.
model SfClient {
  id            String  @id @default(uuid())
  name          String
  contact_name  String?
  contact_phone String?
  contact_email String?
  address       String?
  notes         String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  /// Archive state. A Client with live (non-archived) Projects cannot be archived.
  deleted_at DateTime?

  projects SfProject[]

  @@index([deleted_at])
  @@map("sf_client")
  @@schema("studioflow")
}

/// A StudioFlow Project — the engagement with a Client.
model SfProject {
  id  String @id @default(uuid())

  /// Server-generated unique code (e.g. "SF26-0001"). Immutable after creation.
  code String @unique

  name         String
  client_id    String
  lead_user_id String? // plain FK to platform.User; no Prisma relation

  /// Short site label used in file names. Not a postal address.
  location String?

  /// Site address; independent of Client.address.
  address  String?
  area     Decimal?        @db.Decimal(10, 2)
  status   SfProjectStatus @default(ACTIVE)

  /// Ordering hint for the project list; not a workflow input.
  priority   Int      @default(0)
  opened_at  DateTime

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  client SfClient       @relation(fields: [client_id], references: [id])
  phases SfProjectPhase[]
  files  SfFile[]
  tasks  SfTask[]
  mom_documents SfMomDocument[]

  @@index([client_id])
  @@index([status])
  @@index([deleted_at])
  @@map("sf_project")
  @@schema("studioflow")
}

// ── MOM — project-owned meeting records ─────────────────────────────────────

enum SfMomState {
  DRAFT
  ISSUED
  SUPERSEDED

  @@map("sf_mom_state")
  @@schema("studioflow")
}

enum SfMomListStyle {
  NONE
  BULLET
  NUMBERED

  @@map("sf_mom_list_style")
  @@schema("studioflow")
}

enum SfMomPointStyle {
  TEXT
  BULLET
  NUMBERED

  @@map("sf_mom_point_style")
  @@schema("studioflow")
}

model SfMomDocument {
  id String @id @default(uuid())
  project_id String
  topic String
  meeting_at DateTime
  venue String?
  attendees_text String?
  prepared_by_name String
  state SfMomState @default(DRAFT)
  sequence Int?
  supersedes_id String?
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  issued_by String?
  issued_at DateTime?

  project SfProject @relation(fields: [project_id], references: [id])
  supersedes SfMomDocument? @relation("MomCorrection", fields: [supersedes_id], references: [id], onDelete: Restrict)
  corrections SfMomDocument[] @relation("MomCorrection")
  items SfMomItem[]

  @@unique([project_id, sequence])
  @@index([project_id, state, created_at])
  @@index([supersedes_id])
  @@map("sf_mom_document")
  @@schema("studioflow")
}

model SfMomItem {
  id String @id @default(uuid())
  document_id String
  sort_order Int @default(0)
  is_text_only Boolean @default(false)
  list_style SfMomListStyle @default(NONE)
  document SfMomDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  points SfMomPoint[]
  images SfMomImage[]

  @@index([document_id, sort_order])
  @@map("sf_mom_item")
  @@schema("studioflow")
}

model SfMomPoint {
  id String @id @default(uuid())
  item_id String
  sort_order Int @default(0)
  text String
  style SfMomPointStyle @default(TEXT)
  item SfMomItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id, sort_order])
  @@map("sf_mom_point")
  @@schema("studioflow")
}

model SfMomImage {
  id String @id @default(uuid())
  item_id String
  sort_order Int @default(0)
  storage_key String
  alt_text String?
  item SfMomItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id, sort_order])
  @@map("sf_mom_image")
  @@schema("studioflow")
}

/// A phase on a specific project — snapshot of SfPhaseTemplate at project creation.
/// state is persisted and maintained by the service (§4.3).
model SfProjectPhase {
  id          String @id @default(uuid())
  project_id  String
  template_id String

  // ── Snapshot fields (immutable; survive template edits) ───────────────────
  key          String
  name         String
  sort_order   Int
  has_rounds   Boolean
  round_prefix String?
  folder_key   String?
  requires_internal_approval Boolean @default(false)

  // ── Service-maintained state (§4.3) ───────────────────────────────────────
  state SfPhaseState @default(NOT_STARTED)

  // ── Closure metadata (populated only when state = DONE) ──────────────────
  closed_at      DateTime?
  closed_by_id   String?            // plain FK to platform.User
  closure_reason String?
  closure_kind   SfPhaseClosureKind?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project  SfProject       @relation(fields: [project_id], references: [id])
  template SfPhaseTemplate @relation(fields: [template_id], references: [id])
  iterations SfIteration[]

  /// One phase-key per project; the snapshot is the authority.
  @@unique([project_id, key])
  @@index([project_id, sort_order])
  @@map("sf_project_phase")
  @@schema("studioflow")
}

// ── WO-3: Iteration, Files, Settings ─────────────────────────────────────────

enum SfIterationState {
  DRAFT
  SENT
  APPROVED
  SUPERSEDED
  VOIDED

  @@map("sf_iteration_state")
  @@schema("studioflow")
}

enum SfIterationPointSource {
  CLIENT_REVISION
  INTERNAL

  @@map("sf_iteration_point_source")
  @@schema("studioflow")
}

enum SfFileTreatment {
  RECORDED
  STORED
  LINKED

  @@map("sf_file_treatment")
  @@schema("studioflow")
}

/// Studio-wide settings. One row, id is always "studio".
/// naming_template token vocabulary: {date} {project} {location} {round} {code}
model SfStudioSettings {
  id String @id @default("studio")

  /// Naming template for standard filenames (§8.5).
  /// Default: "{date} {project} {location} {round}"
  naming_template String @default("{date} {project} {location} {round}")

  updated_at    DateTime @updatedAt
  updated_by_id String?

  @@map("sf_studio_settings")
  @@schema("studioflow")
}

/// One numbered round of work in a phase. Replaces legacy Revision.
/// `number` is server-assigned, sequential, gapless within the phase (§5.3).
model SfIteration {
  id       String @id @default(uuid())
  phase_id String

  /// Sequential and gapless within the phase, starting at 1. Server-assigned.
  number Int

  state       SfIterationState @default(DRAFT)
  assignee_id String?

  sent_at      DateTime?
  responded_at DateTime?

  /// Starts at 0. Incremented when the working file is replaced (§5.4).
  working_revision Int @default(0)

  voided_at    DateTime?
  voided_by_id String?
  void_reason  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  phase SfProjectPhase @relation(fields: [phase_id], references: [id])

  points            SfIterationPoint[]
  internal_approval SfInternalApproval?
  sent_files        SfFile[]
  responses         SfResponse[]

  @@unique([phase_id, number])
  @@index([phase_id, state])
  @@map("sf_iteration")
  @@schema("studioflow")
}

/// A checklist item inside a round. `source` is immutable.
model SfIterationPoint {
  id           String @id @default(uuid())
  iteration_id String

  text String
  done Boolean @default(false)

  /// Immutable. CLIENT_REVISION = created by a client answer; INTERNAL = studio.
  source SfIterationPointSource

  source_response_id String?
  source_point_id    String?

  withdrawn_at      DateTime?
  withdrawn_by_id   String?
  withdrawal_reason String?

  sort_order Int @default(0)

  iteration SfIteration @relation(fields: [iteration_id], references: [id])

  @@index([iteration_id, source])
  @@map("sf_iteration_point")
  @@schema("studioflow")
}

/// Optional internal sign-off on a round. At most one per iteration.
model SfInternalApproval {
  id           String @id @default(uuid())
  iteration_id String @unique

  approved_by_id String
  approved_at    DateTime @default(now())
  note           String?

  iteration SfIteration @relation(fields: [iteration_id], references: [id])

  @@map("sf_internal_approval")
  @@schema("studioflow")
}

/// A permanent file record. The bytes may be released (§8.6); the record never is.
/// folder_key = null means the unsorted tray (§8.8).
model SfFile {
  id         String @id @default(uuid())
  project_id String

  folder_key String?
  treatment  SfFileTreatment

  filename          String
  original_filename String

  bytes            BigInt
  file_modified_at DateTime?

  dropped_by_id String
  dropped_at    DateTime @default(now())

  /// Set only by a Send action (§8.3); immutable afterwards.
  sent_in_iteration_id String?

  storage_key String?
  checksum    String?
  external_url String?

  superseded_at     DateTime?
  bytes_released_at DateTime?

  project           SfProject    @relation(fields: [project_id], references: [id])
  sent_in_iteration SfIteration? @relation(fields: [sent_in_iteration_id], references: [id])
  task_attachments  SfTask[]

  @@index([project_id, folder_key])
  @@index([sent_in_iteration_id])
  @@index([project_id, superseded_at])
  @@map("sf_file")
  @@schema("studioflow")
}

/// General or phase-scoped work that is not already represented by an
/// iteration. A null phase_scope is the intentional General scope.
model SfTask {
  id         String @id @default(uuid())
  project_id String

  /// Snapshot phase key from SfProjectPhase. Kept as a plain nullable value so
  /// project-specific template evolution does not require a closed enum.
  phase_scope String?
  title       String
  status      SfTaskStatus @default(OPEN)
  assignee_id String?
  due_date    DateTime?

  /// Optional evidence of internal work; it never marks the file as sent.
  attachment_file_id String?
  sort_order         Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project         SfProject @relation(fields: [project_id], references: [id])
  attachment_file SfFile?   @relation(fields: [attachment_file_id], references: [id])

  @@index([project_id, status, phase_scope, sort_order])
  @@index([assignee_id, status, created_at])
  @@index([attachment_file_id])
  @@map("sf_task")
  @@schema("studioflow")
}

// ── WO-5: Client responses ───────────────────────────────────────────────────

enum SfResponseKind {
  APPROVAL
  REVISION

  @@map("sf_response_kind")
  @@schema("studioflow")
}

/// A recorded client answer to a SENT round (§6).
/// APPROVAL closes the round as APPROVED.
/// REVISION supersedes the round and seeds the next one with CLIENT_REVISION points.
model SfResponse {
  id           String @id @default(uuid())
  iteration_id String

  kind SfResponseKind
  note String?

  received_at    DateTime @default(now())
  recorded_by_id String

  iteration SfIteration       @relation(fields: [iteration_id], references: [id])
  points    SfResponsePoint[]

  @@index([iteration_id])
  @@map("sf_response")
  @@schema("studioflow")
}

/// One revision request inside a client response.
/// `text` is the client's own wording and is never edited after recording (§7.2).
model SfResponsePoint {
  id          String @id @default(uuid())
  response_id String

  text       String
  sort_order Int    @default(0)

  response SfResponse @relation(fields: [response_id], references: [id])

  @@index([response_id])
  @@map("sf_response_point")
  @@schema("studioflow")
}

model SfProductCatalogue {
  id              String    @id @default(uuid())
  brand_md_id     String?
  brand_name      String?
  product_name    String
  colour          String?
  finishing       String?
  dimension_text  String?
  unit            String?
  notes           String?
  search_key      String
  sort_order      Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  @@index([search_key])
  @@index([brand_md_id])
  @@index([deleted_at, sort_order])
  @@map("sf_product_catalogue")
  @@schema("studioflow")
}
